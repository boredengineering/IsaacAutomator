#!/usr/bin/env bash
# ==============================================================================
# isaac-installer - Universal Bare-Metal Physical AI & Robotics Provisioner
# ==============================================================================
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
LIB_CORE="${SCRIPT_DIR}/lib/core"
LIB_MODULES="${SCRIPT_DIR}/lib/modules"

# Source Core Libraries
source "${LIB_CORE}/logging.sh"
source "${LIB_CORE}/detect.sh"
source "${LIB_CORE}/config.sh"
source "${LIB_CORE}/state.sh"
source "${LIB_CORE}/package_manager.sh"
source "${LIB_CORE}/audit.sh"
source "${LIB_CORE}/network.sh"
source "${LIB_CORE}/backup.sh"
source "${LIB_CORE}/git_workspace.sh"

# Source Modules
source "${LIB_MODULES}/driver.sh"
source "${LIB_MODULES}/display.sh"
source "${LIB_MODULES}/system_prereqs.sh"
source "${LIB_MODULES}/conda.sh"
source "${LIB_MODULES}/dev_tools.sh"
source "${LIB_MODULES}/physical_ai.sh"
source "${LIB_MODULES}/hardware_teleop.sh"
source "${LIB_MODULES}/isaacsim.sh"
source "${LIB_MODULES}/isaaclab.sh"
source "${LIB_MODULES}/isaaclab_arena.sh"
source "${LIB_MODULES}/gr00t.sh"
source "${LIB_MODULES}/auth.sh"
source "${LIB_MODULES}/streaming.sh"
source "${LIB_MODULES}/demos.sh"
source "${LIB_MODULES}/ecosystem.sh"

# Register Error & Interrupt Traps
trap 'on_error_trap $? $LINENO "$BASH_COMMAND"' ERR
trap 'on_error_trap 130 $LINENO "SIGINT"' INT

# Global State & Filter Lists
STAGE_CHECK_MSG=""
ONLY_STAGES=""
WITHOUT_STAGES=""
JSON_OUTPUT=false
DRY_RUN=false
INTERACTIVE_STEP=false
AUTO_REBOOT=false
STREAMING_PROVIDER="none"
CUSTOM_CONFIG_FILE=""

# Check if a stage is enabled via YAML configuration or CLI flags
is_stage_selected() {
    local stage_name="$1"
    
    if [[ -n "$WITHOUT_STAGES" ]]; then
        if [[ ",${WITHOUT_STAGES}," == *",${stage_name},"* ]]; then
            return 1
        fi
    fi

    if [[ -n "$ONLY_STAGES" ]]; then
        if [[ ",${ONLY_STAGES}," == *",${stage_name},"* ]]; then
            return 0
        else
            return 1
        fi
    fi

    # Check YAML Profile rules
    case "$stage_name" in
        arena)
            local arena_active=false
            [[ "${CFG_REPOSITORIES_ARENA_ENABLED:-false}" == "true" ]] && arena_active=true
            [[ "${CFG_REPOSITORIES_ARENA:-false}" == "true" ]] && arena_active=true
            [[ "${CFG_REPOSITORIES_ISAACLAB_ARENA_ENABLED:-false}" == "true" ]] && arena_active=true
            [[ "${CFG_REPOSITORIES_ISAACLAB_ARENA:-false}" == "true" ]] && arena_active=true
            [[ "${CFG_ISAACLAB_ARENA_ENABLED:-false}" == "true" ]] && arena_active=true
            [[ "${CFG_ISAACLAB_ARENA:-false}" == "true" ]] && arena_active=true
            [[ "${CFG_ARENA_ENABLED:-false}" == "true" ]] && arena_active=true
            [[ "${CFG_ARENA:-false}" == "true" ]] && arena_active=true
            [[ "${CFG_ECOSYSTEM_ARENA:-false}" == "true" ]] && arena_active=true

            if [[ "$arena_active" != true ]]; then
                STAGE_CHECK_MSG="Disabled in profile (${CONFIG_FILE})"
                return 1
            fi
            ;;
        physical_ai)
            local lerobot_active=false
            [[ "${CFG_REPOSITORIES_LEROBOT_ENABLED:-false}" == "true" ]] && lerobot_active=true
            [[ "${CFG_REPOSITORIES_LEROBOT:-false}" == "true" ]] && lerobot_active=true
            [[ "${CFG_REPOSITORIES_PHYSICAL_AI_ENABLED:-false}" == "true" ]] && lerobot_active=true
            [[ "${CFG_LEROBOT_ENABLED:-false}" == "true" ]] && lerobot_active=true
            [[ "${CFG_LEROBOT:-false}" == "true" ]] && lerobot_active=true
            [[ "${CFG_ECOSYSTEM_LEROBOT:-false}" == "true" ]] && lerobot_active=true
            [[ "${CFG_PHYSICAL_AI_ENABLED:-false}" == "true" ]] && lerobot_active=true

            if [[ "$lerobot_active" != true ]]; then
                STAGE_CHECK_MSG="Disabled in profile (${CONFIG_FILE})"
                return 1
            fi
            ;;
        gr00t)
            local gr00t_active=false
            [[ "${CFG_REPOSITORIES_GR00T_ENABLED:-false}" == "true" ]] && gr00t_active=true
            [[ "${CFG_REPOSITORIES_GR00T:-false}" == "true" ]] && gr00t_active=true
            [[ "${CFG_GR00T_ENABLED:-false}" == "true" ]] && gr00t_active=true
            [[ "${CFG_GR00T:-false}" == "true" ]] && gr00t_active=true
            [[ "${CFG_REPOSITORIES_ISAAC_GR00T_ENABLED:-false}" == "true" ]] && gr00t_active=true

            if [[ "$gr00t_active" != true ]]; then
                STAGE_CHECK_MSG="Disabled in profile (${CONFIG_FILE})"
                return 1
            fi
            ;;
        demos)
            if [[ "${CFG_DEMOS_DESKTOP_SHORTCUTS:-${CFG_ECOSYSTEM_DEMOS:-true}}" != "true" ]]; then
                STAGE_CHECK_MSG="Disabled in profile (${CONFIG_FILE})"
                return 1
            fi
            ;;
    esac

    return 0
}

evaluate_and_run_stage() {
    local stage_name="$1"
    local stage_desc="$2"
    local check_func="$3"
    local install_func="$4"

    CURRENT_STAGE_RUNNING="$stage_name"
    STAGE_CHECK_MSG=""

    if ! is_stage_selected "$stage_name"; then
        if [[ "$DRY_RUN" == true ]]; then
            local reason="${STAGE_CHECK_MSG:-Filtered out by options}"
            echo -e "  ${CLR_GRAY}⊘ [DRY-RUN] Excluded [${stage_name}]:${CLR_RESET} ${reason}"
        fi
        return 0
    fi

    local check_passed=false
    
    set +e
    "$check_func"
    local check_status=$?
    set -e

    if [[ "$check_status" -eq 0 ]]; then
        check_passed=true
    fi

    if [[ "$check_passed" == true ]]; then
        if [[ "$DRY_RUN" == true ]]; then
            echo -e "  ${CLR_GREEN}${GLYPH_CHECK} [DRY-RUN] Skip [${stage_name}]:${CLR_RESET} ${STAGE_CHECK_MSG}"
        else
            log_success "Stage [${stage_name}] already satisfied: ${STAGE_CHECK_MSG}"
            set_stage "${stage_name}"
        fi
        return 0
    fi

    # Action is required
    if [[ "$DRY_RUN" == true ]]; then
        echo -e "  ${CLR_YELLOW}${GLYPH_ARROW} [DRY-RUN] Would execute [${stage_name}]:${CLR_RESET} ${stage_desc} (${STAGE_CHECK_MSG})"
        return 0
    fi

    if [[ "$INTERACTIVE_STEP" == true ]]; then
        echo -e "\n${CLR_BOLD}${CLR_CYAN}▶ Proposed Stage: [${stage_name}] - ${stage_desc}${CLR_RESET}"
        echo -e "  ${CLR_GRAY}Reason: ${STAGE_CHECK_MSG}${CLR_RESET}"
        read -r -p "  Proceed with this stage? [Y/n/s(kip)]: " choice
        case "$choice" in
            [nN]*) log_warn "Execution cancelled by operator."; exit 0 ;;
            [sS]*) log_info "Skipping stage ${stage_name}."; return 0 ;;
            *)     ;;
        esac
    fi

    local start_ns
    start_ns=$(date +%s%N)
    "$install_func"
    local end_ns
    end_ns=$(date +%s%N)
    local dur_sec
    dur_sec=$(awk "BEGIN {printf \"%.2f\", ($end_ns - $start_ns)/1000000000}")
    log_success "Completed [${stage_name}] in ${dur_sec}s"
    set_stage "${stage_name}"
}

cmd_doctor() {
    probe_system

    local ws_dir
    ws_dir="$(resolve_default_workspace_dir)"
    local resolved_lab
    resolved_lab="$(resolve_isaaclab_dir)"
    local resolved_arena
    resolved_arena="$(resolve_arena_dir)"
    local resolved_lerobot
    resolved_lerobot="$(resolve_lerobot_dir)"

    if [[ "$JSON_OUTPUT" == true ]]; then
        python3 -c "
import json
data = {
    'user': '${TARGET_USER}',
    'home': '${TARGET_HOME}',
    'profile': '${PROFILE_NAME}',
    'config_file': '${CONFIG_FILE}',
    'os': '${OS_NAME} ${OS_VERSION}',
    'kernel': '${KERNEL_VERSION}',
    'workspace_root': '${ws_dir}',
    'repositories': {
        'isaaclab': '${resolved_lab}',
        'arena': '${resolved_arena}',
        'lerobot': '${resolved_lerobot}',
        'isaacsim': '${ISAACSIM_DIR:-${TARGET_HOME}/IsaacSim}'
    },
    'cpu': {
        'model': '${CPU_MODEL}',
        'cores': int('${CPU_CORES}' or 1)
    },
    'ram': {
        'total_gb': int('${TOTAL_RAM_GB}' or 0),
        'available_gb': int('${AVAILABLE_RAM_GB}' or 0)
    },
    'disk_free_gb': int('${FREE_DISK_GB}' or 0),
    'apt_locked': '${APT_LOCKED}' == 'true',
    'apt_lock_holder': '${APT_LOCK_HOLDER}',
    'gpu': {
        'found': '${GPU_FOUND}' == 'true',
        'count': int('${GPU_COUNT}' or 0),
        'name': '${GPU_NAME}',
        'driver_installed': '${DRIVER_INSTALLED}' == 'true',
        'driver_version': '${DRIVER_VERSION}',
        'is_blackwell': '${HAS_BLACKWELL}' == 'true',
        'pcie_link': '${PCIE_LINK_INFO}',
        'recommended_driver': '${RECOMMENDED_DRIVER}'
    },
    'display': {
        'mode': '${DISPLAY_MODE}',
        'physical_monitor': '${HAS_PHYSICAL_MONITOR}' == 'true',
        'is_wayland': '${IS_WAYLAND}' == 'true'
    }
}
print(json.dumps(data, indent=2))
"
        return 0
    fi

    log_header "Isaac Installer System Doctor & Hardware Probe"

    log_card_start "Host CPU & Memory Topology"
    log_card_item "Target User" "${TARGET_USER} (${TARGET_HOME})"
    log_card_item "Active Profile" "${PROFILE_NAME} (${CONFIG_FILE})"
    log_card_item "Operating System" "${OS_NAME} ${OS_VERSION} (Kernel: ${KERNEL_VERSION})"
    log_card_item "Processor (CPU)" "${CPU_MODEL} (${CPU_CORES} logical cores)"
    log_card_item "System Memory" "${TOTAL_RAM_GB} GB Total (${AVAILABLE_RAM_GB} GB Available)"
    log_card_item "Available Storage" "${FREE_DISK_GB} GB"
    if [[ "$APT_LOCKED" == true ]]; then
        log_card_item "Package Manager" "${CLR_RED}Locked by: ${APT_LOCK_HOLDER}${CLR_RESET}"
    else
        log_card_item "Package Manager" "${CLR_GREEN}Unlocked (Ready)${CLR_RESET}"
    fi
    log_card_end

    log_card_start "NVMe High-Speed Storage & LVM"
    if [[ "$NVME_COUNT" -gt 0 ]]; then
        log_card_item "NVMe Devices" "${NVME_COUNT} high-speed drive(s) detected"
        for d in "${NVME_DRIVES[@]}"; do
            log_card_item "Drive" "${d}"
        done
    else
        log_card_item "NVMe Devices" "Standard SATA / Virtual disk active"
    fi
    if [[ ${#LVM_VOLUME_GROUPS[@]} -gt 0 ]]; then
        for vg in "${LVM_VOLUME_GROUPS[@]}"; do
            log_card_item "LVM Volume Group" "${vg}"
        done
    else
        log_card_item "LVM Volumes" "None configured"
    fi
    log_card_end

    log_card_start "Workspace & Repository Targets"
    log_card_item "Workspace Root" "${ws_dir}"
    log_card_item "Isaac Lab Target" "${resolved_lab}"
    log_card_item "Arena Target" "${resolved_arena}"
    log_card_item "LeRobot Target" "${resolved_lerobot}"
    log_card_item "Isaac Sim Target" "${ISAACSIM_DIR:-${TARGET_HOME}/IsaacSim}"
    log_card_end

    log_card_start "NVIDIA GPU Topology & PCIe Link"
    if [[ "$GPU_FOUND" == true ]]; then
        log_card_item "Total GPUs" "${GPU_COUNT}"
        for gpu in "${GPUS[@]}"; do
            log_card_item "Topology" "${gpu}"
        done
        if [[ "$HAS_BLACKWELL" == true ]]; then
            log_card_item "Architecture" "${CLR_MAGENTA}Blackwell${CLR_RESET} (Enforces Driver >= 570)"
        fi
        if [[ "$DRIVER_INSTALLED" == true ]]; then
            log_card_item "Active Driver" "${CLR_GREEN}v${DRIVER_VERSION}${CLR_RESET} (Target: >= ${RECOMMENDED_DRIVER})"
        else
            log_card_item "Active Driver" "${CLR_RED}Not Loaded${CLR_RESET}"
        fi
        if [[ "$PCIE_LINK_INFO" != "Unknown" ]]; then
            log_card_item "PCIe Link State" "${PCIE_LINK_INFO}"
        fi
    else
        log_card_item "GPU Status" "${CLR_RED}No NVIDIA GPU detected on PCIe bus${CLR_RESET}"
    fi
    log_card_end

    log_card_start "Display Server & Rendering Session"
    if [[ "$HAS_PHYSICAL_MONITOR" == true ]]; then
        log_card_item "Display Server" "${CLR_GREEN}${DISPLAY_MODE}${CLR_RESET} (Physical monitor detected)"
    else
        log_card_item "Display Server" "${CLR_YELLOW}Headless${CLR_RESET} (Virtual EDID suggested)"
    fi
    if [[ "$IS_WAYLAND" == true ]]; then
        log_card_item "Session Protocol" "${CLR_RED}Wayland${CLR_RESET} (X11 enforcement required)"
    else
        log_card_item "Session Protocol" "${CLR_GREEN}X11 Compliant${CLR_RESET}"
    fi
    log_card_end
}

cmd_plan() {
    probe_system
    if [[ "$JSON_OUTPUT" == true ]]; then
        export_audit_json
    else
        print_audit_report
    fi
}

cmd_bench() {
    log_header "Network CDN Latency & Bandwidth Pre-Flight Benchmark"
    benchmark_network_preflight
}

cmd_auth() {
    local subcmd="${1:-status}"
    shift || true

    case "$subcmd" in
        status)
            if [[ "$JSON_OUTPUT" == true ]]; then
                export_auth_json
            else
                print_auth_dashboard
            fi
            ;;
        login)
            auth_login_provider "${1:-all}"
            ;;
        gen-ssh|ssh)
            auth_generate_ssh_key
            ;;
        git|identity)
            auth_configure_git
            ;;
        check-perms|fix-perms)
            auth_fix_permissions
            ;;
        *)
            log_error "Unknown auth subcommand: ${subcmd}"
            echo "Usage: isaac-installer auth [status | login <provider> | gen-ssh | git | check-perms]"
            exit 1
            ;;
    esac
}

cmd_install() {
    init_logging "$@"
    log_header "Starting Isaac Workstation Installation Assessment"
    probe_system

    if [[ "$DRY_RUN" != true && "$EUID" -ne 0 ]]; then
        log_fatal "Installation requires root privileges. Please run with: sudo ./bin/isaac-installer install"
    fi

    init_state
    local overall_start_ns
    overall_start_ns=$(date +%s%N)

    # Stage 1: Driver & Display
    evaluate_and_run_stage "driver" "NVIDIA GPU driver & kernel modules" check_driver install_nvidia_driver
    evaluate_and_run_stage "display" "X11 enforcement & GDM Wayland toggle" check_display_server configure_display_server

    # Stage 2: System Prereqs & Compilers
    evaluate_and_run_stage "prereqs" "Vulkan runtime, dev headers, GCC 11 & Git LFS" check_system_prereqs install_system_prereqs

    # Stage 3: Python Runtime & Dev Tools
    evaluate_and_run_stage "python" "Miniforge & uv package manager" check_python_env install_python_env
    evaluate_and_run_stage "devtools" "$(get_devtools_description)" check_dev_tools install_dev_tools

    # Stage 4: Physical AI & Hardware Teleop
    evaluate_and_run_stage "physical_ai" "Hugging Face CLI, LeRobot, lerobot-dataset-viz & video codecs" check_physical_ai install_physical_ai_stack
    evaluate_and_run_stage "hardware_teleop" "$(get_teleop_description)" check_hardware_teleop install_hardware_teleop

    # Stage 5: Isaac Sim Engine
    evaluate_and_run_stage "isaacsim" "NVIDIA Isaac Sim standalone extraction & EULA" check_isaac_sim install_isaac_sim

    # Stage 6: Isaac Lab
    evaluate_and_run_stage "isaaclab" "Isaac Lab clone, _isaac_sim link & PyTorch verification" check_isaac_lab install_isaac_lab

    # Stage 7: IsaacLab-Arena & Isaac-GR00T
    evaluate_and_run_stage "arena" "IsaacLab-Arena benchmark suite" check_isaaclab_arena install_isaaclab_arena
    evaluate_and_run_stage "gr00t" "NVIDIA Isaac-GR00T Foundation Model Stack & Python 3.12" check_gr00t install_gr00t

    # Stage 8: Demos & Desktop Shortcuts
    evaluate_and_run_stage "demos" "Desktop .desktop launchers for Unitree G1, Go2 & Franka" check_demos install_demos_and_shortcuts

    # Stage 9: Optional Streaming (Strictly opt-in)
    if [[ "$STREAMING_PROVIDER" != "none" ]]; then
        install_streaming_provider "$STREAMING_PROVIDER"
    fi

    local overall_end_ns
    overall_end_ns=$(date +%s%N)
    local total_sec
    total_sec=$(awk "BEGIN {printf \"%.2f\", ($overall_end_ns - $overall_start_ns)/1000000000}")

    if [[ "$DRY_RUN" == true ]]; then
        log_header "Dry-Run Simulation Complete (${total_sec}s)"
        log_info "Profile: ${PROFILE_NAME} (${CONFIG_FILE})"
        log_info "No system modifications were made."
    else
        set_stage "completed"
        clear_resume_hook
        log_header "Installation Complete! (${total_sec}s)"
        log_success "Profile [${PROFILE_NAME}] successfully provisioned."
        log_info "Full session log saved to: ${CURRENT_LOG_FILE}"
    fi
}

cmd_resume() {
    init_logging "$@"
    log_header "Resuming Isaac Workstation Installation..."
    probe_system
    cmd_install
}

cmd_test() {
    log_header "Running Profile-Aware Workstation Verification Suite"
    log_info "Active Profile: ${PROFILE_NAME} (${CONFIG_FILE})"
    probe_system

    local tests_passed=0
    local tests_total=0

    # 1. NVIDIA Driver
    tests_total=$((tests_total + 1))
    log_step "1. Testing NVIDIA Driver & GPU Topology..."
    if nvidia-smi &>/dev/null; then
        log_success "NVIDIA Driver OK: $(nvidia-smi --query-gpu=name,driver_version --format=csv,noheader | head -n 1)"
        tests_passed=$((tests_passed + 1))
    else
        log_error "NVIDIA Driver test failed."
    fi

    # 2. Display Server
    tests_total=$((tests_total + 1))
    log_step "2. Testing Display Server (X11 / Wayland)..."
    if [[ "$IS_WAYLAND" == false ]]; then
        log_success "Display Server is X11 compliant (Vulkan compatible)."
        tests_passed=$((tests_passed + 1))
    else
        log_warn "Active display session is Wayland."
    fi

    # 3. Compilers & Vulkan
    tests_total=$((tests_total + 1))
    log_step "3. Testing GCC Compiler & Vulkan Development Headers..."
    if command -v gcc &>/dev/null && pkg_is_installed "libvulkan-dev" 2>/dev/null; then
        log_success "GCC $(gcc -dumpversion 2>/dev/null) & libvulkan-dev verified."
        tests_passed=$((tests_passed + 1))
    else
        log_warn "GCC 11 or libvulkan-dev is missing."
    fi

    # 4. Git & Git LFS
    tests_total=$((tests_total + 1))
    log_step "4. Testing Git & Git Large File Storage (Git LFS)..."
    if command -v git-lfs &>/dev/null; then
        log_success "Git LFS is active: $(git-lfs --version | awk '{print $1}')"
        tests_passed=$((tests_passed + 1))
    else
        log_warn "Git LFS is not installed (3D meshes will clone as text pointers)."
    fi

    # 5. Docker Engine & NVIDIA Container Toolkit
    tests_total=$((tests_total + 1))
    log_step "5. Testing Docker Engine & NVIDIA GPU Passthrough..."
    if command -v docker &>/dev/null; then
        if sudo docker info &>/dev/null; then
            if sudo docker run --rm --gpus all nvidia/cuda:12.2.0-base-ubuntu22.04 nvidia-smi &>/dev/null; then
                log_success "Docker GPU Passthrough verified with NVIDIA Container Toolkit."
                tests_passed=$((tests_passed + 1))
            else
                log_warn "Docker installed, but GPU passthrough failed (check nvidia-ctk)."
            fi
        else
            log_warn "Docker service is not running."
        fi
    else
        log_warn "Docker CE is not installed."
    fi

    # 6. Developer Applications (VS Code, Chrome, GitHub Desktop)
    if [[ "${CFG_DEVTOOLS_VSCODE:-true}" == "true" || "${CFG_DEVTOOLS_CHROMIUM:-true}" == "true" || "${CFG_DEVTOOLS_GITHUB_DESKTOP:-true}" == "true" ]]; then
        tests_total=$((tests_total + 1))
        log_step "6. Testing Configured Developer Applications..."
        local dev_apps=()
        command -v code &>/dev/null && dev_apps+=("VS Code")
        (command -v google-chrome &>/dev/null || command -v chromium-browser &>/dev/null || command -v chromium &>/dev/null) && dev_apps+=("Chrome/Chromium")
        command -v github-desktop &>/dev/null && dev_apps+=("GitHub Desktop")

        if [[ ${#dev_apps[@]} -ge 1 ]]; then
            log_success "Developer Apps active: ${dev_apps[*]}"
            tests_passed=$((tests_passed + 1))
        else
            log_warn "Configured developer apps not yet installed."
        fi
    fi

    # 7. Cloud & Hub CLIs
    if [[ "${CFG_DEVTOOLS_CLOUD_CLIS_AWS:-false}" == "true" || "${CFG_DEVTOOLS_CLOUD_CLIS_GCLOUD:-false}" == "true" ]]; then
        tests_total=$((tests_total + 1))
        log_step "7. Testing Cloud CLIs (AWS, GCP)..."
        local clis=()
        command -v aws &>/dev/null && clis+=("aws")
        command -v gcloud &>/dev/null && clis+=("gcloud")

        if [[ ${#clis[@]} -gt 0 ]]; then
            log_success "Cloud CLIs present: ${clis[*]}"
            tests_passed=$((tests_passed + 1))
        else
            log_warn "Configured Cloud CLIs are missing."
        fi
    fi

    # 8. High-Speed NVMe & LVM Storage Subsystem
    if [[ "${CFG_HARDWARE_ENABLE_NVME_STORAGE_TOOLS:-true}" == "true" ]]; then
        tests_total=$((tests_total + 1))
        log_step "8. Testing NVMe Management & LVM Storage Stack..."
        local storage_ok=true
        if command -v nvme &>/dev/null; then
            log_success "nvme-cli is installed ($(nvme version 2>/dev/null | head -n 1 || echo "active"))."
        else
            log_warn "nvme-cli is missing."
            storage_ok=false
        fi
        if command -v lvm &>/dev/null; then
            log_success "LVM2 logical volume manager is active."
        else
            log_warn "lvm2 is missing."
            storage_ok=false
        fi
        if [[ "$storage_ok" == true ]]; then
            tests_passed=$((tests_passed + 1))
        fi
    fi

    # 9. Physical AI / LeRobot (Only if enabled in YAML profile)
    if [[ "${CFG_REPOSITORIES_LEROBOT_ENABLED:-${CFG_ECOSYSTEM_LEROBOT:-false}}" == "true" ]]; then
        tests_total=$((tests_total + 1))
        log_step "9. Testing Physical AI (Hugging Face CLI & LeRobot Dataset Visualizer)..."
        if (command -v huggingface-cli &>/dev/null || command -v hf &>/dev/null) && command -v lerobot-dataset-viz &>/dev/null; then
            log_success "huggingface-cli and lerobot-dataset-viz are verified in PATH."
            tests_passed=$((tests_passed + 1))
        else
            log_warn "LeRobot dataset visualizer or Hugging Face CLI not found in /usr/local/bin."
        fi
    fi

    # 10. Hardware Teleoperation Rules (Only if enabled in YAML profile)
    if [[ "${CFG_TELEOPERATION_FTDI_1MS_LATENCY_RULE:-true}" == "true" ]]; then
        tests_total=$((tests_total + 1))
        log_step "10. Testing Hardware Teleop Serial Latency (1ms FTDI rule)..."
        if [[ -f /etc/udev/rules.d/99-ftdi-latency.rules ]]; then
            log_success "1ms FTDI low-latency serial udev rule is active."
            tests_passed=$((tests_passed + 1))
        else
            log_warn "99-ftdi-latency.rules missing (default 16ms serial lag active)."
        fi
    fi

    if [[ "${CFG_TELEOPERATION_SPACEMOUSE_DAEMON:-false}" == "true" ]]; then
        tests_total=$((tests_total + 1))
        log_step "Testing SpaceMouse Daemon (spacenavd)..."
        if systemctl is-active --quiet spacenavd 2>/dev/null; then
            log_success "SpaceMouse daemon (spacenavd) is active."
            tests_passed=$((tests_passed + 1))
        else
            log_warn "SpaceMouse daemon (spacenavd) is not running."
        fi
    fi

    # 11. Isaac Sim Standalone Engine
    tests_total=$((tests_total + 1))
    log_step "11. Testing NVIDIA Isaac Sim Engine..."
    local sim_dir
    sim_dir="$(resolve_isaacsim_dir)"
    if [[ -x "${sim_dir}/isaac-sim.sh" && -f "${sim_dir}/.eula_accepted" ]]; then
        log_success "Isaac Sim engine ready at ${sim_dir}"
        tests_passed=$((tests_passed + 1))
    else
        log_warn "Isaac Sim engine not found or EULA not accepted at ${sim_dir}."
    fi

    # 12. Isaac Lab PyTorch CUDA Linkage
    tests_total=$((tests_total + 1))
    log_step "12. Testing Isaac Lab PyTorch CUDA Acceleration..."
    local lab_dir
    lab_dir="$(resolve_isaaclab_dir)"
    if [[ -d "${lab_dir}" && -L "${lab_dir}/_isaac_sim" ]]; then
        if sudo -H -u "${TARGET_USER}" bash -c "cd '${lab_dir}' && ./isaaclab.sh -p -c 'import torch; assert torch.cuda.is_available()' 2>/dev/null"; then
            log_success "Isaac Lab PyTorch CUDA verified successfully."
            tests_passed=$((tests_passed + 1))
        else
            log_warn "Isaac Lab PyTorch CUDA check encountered an issue."
        fi
    else
        log_info "Isaac Lab framework is not yet installed at ${lab_dir}."
    fi

    # 13. IsaacLab-Arena Benchmark Suite (Only if enabled in YAML profile)
    if [[ "${CFG_REPOSITORIES_ARENA_ENABLED:-${CFG_ECOSYSTEM_ARENA:-true}}" == "true" ]]; then
        tests_total=$((tests_total + 1))
        log_step "13. Testing IsaacLab-Arena Benchmark Suite & Extensions..."
        local arena_dir
        arena_dir="$(resolve_arena_dir)"
        if [[ -d "${arena_dir}" && -d "${lab_dir}" ]]; then
            if sudo -H -u "${TARGET_USER}" bash -c "cd '${lab_dir}' && ./isaaclab.sh -p -c 'import gymnasium as gym; import arena' 2>/dev/null"; then
                log_success "IsaacLab-Arena extension and Gymnasium tasks verified."
                tests_passed=$((tests_passed + 1))
            else
                log_warn "IsaacLab-Arena extension import probe encountered an issue."
            fi
        else
            log_info "IsaacLab-Arena benchmark suite not installed at ${arena_dir}."
        fi
    fi

    # 14. NVIDIA Isaac-GR00T Foundation Model Stack (Only if enabled in YAML profile)
    if [[ "${CFG_REPOSITORIES_GR00T_ENABLED:-${CFG_ECOSYSTEM_GR00T:-true}}" == "true" ]]; then
        tests_total=$((tests_total + 1))
        log_step "14. Testing NVIDIA Isaac-GR00T VLA Stack & Python 3.12..."
        local gr00t_dir
        gr00t_dir="$(resolve_gr00t_dir)"
        if [[ -d "${gr00t_dir}" ]]; then
            if sudo -H -u "${TARGET_USER}" bash -c "cd '${gr00t_dir}' && export PATH=\"\$HOME/.cargo/bin:\$PATH\" && uv run python -c 'import gr00t' 2>/dev/null"; then
                log_success "NVIDIA Isaac-GR00T core Python 3.12 modules loaded successfully."
                tests_passed=$((tests_passed + 1))
            else
                log_warn "Isaac-GR00T core module import failed."
            fi
        else
            log_info "Isaac-GR00T foundation model stack not installed at ${gr00t_dir}."
        fi
    fi

    # 15. Desktop Shortcuts & Demos (Only if enabled in YAML)
    if [[ "${CFG_DEMOS_DESKTOP_SHORTCUTS:-${CFG_ECOSYSTEM_DEMOS:-true}}" == "true" ]]; then
        tests_total=$((tests_total + 1))
        log_step "15. Testing Desktop Shortcuts & Physical AI Demo Launchers..."
        if [[ -f "${TARGET_HOME}/Desktop/Humanoid-Locomotion-G1.desktop" && -f "${TARGET_HOME}/Desktop/Arena-Benchmark-Kit.desktop" ]]; then
            log_success "Desktop launchers for Unitree G1, Go2, Franka, Arena, and GR00T are ready."
            tests_passed=$((tests_passed + 1))
        else
            log_info "Desktop shortcuts not yet deployed or partially deployed."
        fi
    fi

    echo ""
    log_card_start "Verification Summary (${PROFILE_NAME})"
    log_card_item "Tests Passed" "${tests_passed} / ${tests_total}"
    local score_pct
    score_pct=$(awk "BEGIN {printf \"%.0f\", (${tests_passed}/${tests_total}) * 100}")
    if [[ "$score_pct" -ge 80 ]]; then
        log_card_item "Health Status" "${CLR_GREEN}Workstation Ready (${score_pct}%)${CLR_RESET}"
    else
        log_card_item "Health Status" "${CLR_YELLOW}Action Required (${score_pct}% Ready)${CLR_RESET}"
    fi
    log_card_end
}

usage() {
    cat << HELP
Isaac Installer - Universal Bare-Metal Physical AI & Robotics Provisioner

Usage:
  isaac-installer <command> [options]

Commands:
  auth [status|login|gen-ssh|git|check-perms]  Manage OAuth, API keys, Cloud Hubs & permissions
  doctor                                       Probe CPU, RAM, GPU, PCIe link, display, and OS
  plan | check                                 Perform deep pre-flight audit & conflict diff matrix
  drift                                        Audit workspace directory hierarchy & remote state drift
  repair | fix                                 Automatically reconcile and heal workspace drift
  lab [status|list-tags|switch|sync|fork]      Manage Isaac Lab versioning, tags, and fork synchronization
  arena [status|list-tags|switch|sync|fork]    Manage IsaacLab-Arena versioning, tags, and fork synchronization
  gr00t [status|infer|server|test|fork]        Manage NVIDIA Isaac-GR00T VLA model, serving & inference
  sim [list|switch]                            Discover & switch active Isaac Sim engines
  bench                                        Benchmark CDN latency to NVIDIA, Hugging Face, and GitHub
  config                                       Display active YAML configuration profile
  install                                      Run bare-metal installation according to YAML profile
  resume                                       Resume installation from last recorded checkpoint
  test                                         Run profile-aware verification suite
  logs [latest|--tail|-t|--list|-l|--follow|-f] Inspect persistent session and error logs
  stream <provider>                            Setup 3D streaming (nomachine | sunshine)
  backups                                      List configuration safety snapshots
  help                                         Show this message

Profiles & Configuration Options:
  --config <path>              Path to custom YAML configuration profile
  --profile <name>             Preset profile: default | minimal | full
  --dry-run                    Simulate installation without making any system changes
  --step | -i                  Interactive step-by-step mode (prompts before each stage)
  --json                       Output doctor / plan / auth in structured JSON format
  --workspace-dir <path>       Base directory for repos (Default: ~/Documents/GitHub)
  --workspace-layout <type>    Layout hierarchy strategy: auto | org | flat
  --workspace-owner <owner>    Default GitHub organization / user folder name
  --isaaclab-repo <url/slug>   Custom fork for Isaac Lab (e.g. BoredEngineer/IsaacLab)
  --isaaclab-tag <tag>         Pin specific Isaac Lab release tag (e.g. v2.3.0)
  --isaaclab-branch <branch>   Custom branch for Isaac Lab (e.g. main)
  --arena-repo <url/slug>      Custom fork for Arena (e.g. BoredEngineer/IsaacLab-Arena)
  --arena-tag <tag>            Pin specific Arena release tag (e.g. v0.1.1)
  --arena-branch <branch>      Custom branch for Arena
  --lerobot-repo <url/slug>    Custom fork for LeRobot (e.g. BoredEngineer/lerobot)
  --lerobot-tag <tag>          Pin specific LeRobot release tag
  --lerobot-branch <branch>    Custom branch for LeRobot
  --gr00t-repo <url/slug>      Custom fork for Isaac-GR00T (e.g. BoredEngineer/Isaac-GR00T)
  --gr00t-tag <tag>            Pin specific Isaac-GR00T release tag
  --gr00t-branch <branch>      Custom branch for Isaac-GR00T
  --isaacsim-dir <path>        Custom path to Isaac Sim standalone engine
  --with-arena                 Explicitly enable IsaacLab-Arena
  --with-lerobot               Explicitly enable Hugging Face LeRobot
  --with-gr00t                 Explicitly enable NVIDIA Isaac-GR00T VLA Stack
  --only <stages>              Comma-separated stages to run (e.g. devtools,sim,lab)
  --without <stages>           Comma-separated stages to exclude (e.g. demos,stream)

Available Stage Names:
  driver, display, prereqs, python, devtools, physical_ai, hardware_teleop, isaacsim, isaaclab, arena, gr00t, demos

HELP
}

# --- CLI Argument Parsing ---
COMMAND="${1:-help}"
shift || true

PASSTHROUGH_ARGS=()
CLI_WITH_ARENA=false
CLI_WITH_LEROBOT=false
CLI_WITH_GR00T=false

while [[ $# -gt 0 ]]; do
    case "$1" in
        --config)              CUSTOM_CONFIG_FILE="$2"; shift 2 ;;
        --profile)             CUSTOM_CONFIG_FILE="$2"; shift 2 ;;
        --dry-run)             DRY_RUN=true; shift ;;
        --step|-i)             INTERACTIVE_STEP=true; shift ;;
        --json)                JSON_OUTPUT=true; shift ;;
        --only)                ONLY_STAGES="$2"; shift 2 ;;
        --without)             WITHOUT_STAGES="$2"; shift 2 ;;
        --with-arena)          CLI_WITH_ARENA=true; shift ;;
        --with-lerobot)        CLI_WITH_LEROBOT=true; shift ;;
        --with-gr00t)          CLI_WITH_GR00T=true; shift ;;
        --workspace-dir)       export WORKSPACE_DIR="$2"; shift 2 ;;
        --workspace-layout)    export WORKSPACE_LAYOUT="$2"; shift 2 ;;
        --workspace-owner)     export WORKSPACE_DEFAULT_OWNER="$2"; shift 2 ;;
        --isaaclab-repo)       export ISAACLAB_REPO="$2"; shift 2 ;;
        --isaaclab-tag)        export ISAACLAB_TAG="$2"; shift 2 ;;
        --isaaclab-branch)     export ISAACLAB_BRANCH="$2"; shift 2 ;;
        --isaaclab-dir)        export ISAACLAB_DIR="$2"; shift 2 ;;
        --arena-repo)          export ARENA_REPO="$2"; shift 2 ;;
        --arena-tag)           export ARENA_TAG="$2"; shift 2 ;;
        --arena-branch)        export ARENA_BRANCH="$2"; shift 2 ;;
        --arena-dir)           export ARENA_DIR="$2"; shift 2 ;;
        --lerobot-repo)        export LEROBOT_REPO="$2"; shift 2 ;;
        --lerobot-tag)         export LEROBOT_TAG="$2"; shift 2 ;;
        --lerobot-branch)      export LEROBOT_BRANCH="$2"; shift 2 ;;
        --lerobot-dir)         export LEROBOT_DIR="$2"; shift 2 ;;
        --gr00t-repo)          export GR00T_REPO="$2"; shift 2 ;;
        --gr00t-tag)           export GR00T_TAG="$2"; shift 2 ;;
        --gr00t-branch)        export GR00T_BRANCH="$2"; shift 2 ;;
        --gr00t-dir)           export GR00T_DIR="$2"; shift 2 ;;
        --isaacsim-dir)        export ISAACSIM_DIR="$2"; shift 2 ;;
        --stream)              STREAMING_PROVIDER="$2"; shift 2 ;;
        --auto-reboot)         AUTO_REBOOT=true; shift ;;
        *)                     PASSTHROUGH_ARGS+=("$1"); shift ;;
    esac
done

# 1. Load Active YAML Profile
load_config_profile "${CUSTOM_CONFIG_FILE:-${DEFAULT_CONFIG_PATH}}"

# 2. Apply Explicit CLI Overrides on Top of Profile
if [[ "$CLI_WITH_ARENA" == true ]]; then
    export CFG_REPOSITORIES_ARENA_ENABLED="true"
fi
if [[ "$CLI_WITH_LEROBOT" == true ]]; then
    export CFG_REPOSITORIES_LEROBOT_ENABLED="true"
fi
if [[ "$CLI_WITH_GR00T" == true ]]; then
    export CFG_REPOSITORIES_GR00T_ENABLED="true"
fi

case "${COMMAND}" in
    auth)             cmd_auth "${PASSTHROUGH_ARGS[@]:-status}" ;;
    doctor)           cmd_doctor ;;
    plan|check|audit) cmd_plan ;;
    drift)            print_drift_report ;;
    repair|fix)       repair_workspace_drift ;;
    lab)              cmd_lab "${PASSTHROUGH_ARGS[@]:-status}" ;;
    arena)            cmd_arena "${PASSTHROUGH_ARGS[@]:-status}" ;;
    gr00t)            cmd_gr00t "${PASSTHROUGH_ARGS[@]:-status}" ;;
    sim)              cmd_sim "${PASSTHROUGH_ARGS[@]:-list}" ;;
    bench)            cmd_bench ;;
    config)           print_active_config ;;
    install)          cmd_install ;;
    resume)           cmd_resume ;;
    test)             
        case "${PASSTHROUGH_ARGS[0]:-all}" in
            --arena|arena) test_isaaclab_arena ;;
            --gr00t|gr00t) test_gr00t ;;
            --lab|lab)     test_isaac_lab ;;
            *)             cmd_test ;;
        esac
        ;;
    validate)
        case "${PASSTHROUGH_ARGS[0]:-arena}" in
            arena) test_isaaclab_arena ;;
            gr00t) test_gr00t ;;
            *)     test_isaaclab_arena ;;
        esac
        ;;
    logs)             cmd_logs "${PASSTHROUGH_ARGS[@]:-latest}" ;;
    stream)           install_streaming_provider "${PASSTHROUGH_ARGS[0]:-nomachine}" ;;
    backups)          list_backups ;;
    help|--help|-h)   usage ;;
    *)
        log_error "Unknown command: ${COMMAND}"
        usage
        exit 1
        ;;
esac
