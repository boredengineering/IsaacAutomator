    {
      "id": "STEP1-TEST-BOUNDARY",
      "category": "concrete_test_scope_defect",
      "severity": "high",
      "blocking": true,
      "title": "The nominal pure evidence suite imports managed_apply and transitively fixture_builders in its final two tests",
      "source_refs": [
        "src/tests/installer_plan_evidence.test.py:169-206",
        "src/tests/installer_plan_evidence.test.py:208-226",
        "isaac-installer/lib/core/managed_apply.py:24-31,332-361"
      ],
      "detail": "The penultimate test loads managed_apply, constructs Root, calls managed._builders.tree_digest, writes/chmods a synthetic verified journal, then calls inspect_fixture. The final test also loads managed_apply, creates a directory/file and calls inspect_fixture. Loading managed_apply executes the fixture_builders module loader. Neither of these two test bodies directly calls apply_plan, build_environment or build_repository; do not misdescribe them as actual installs. They nevertheless cross the explicit no-managed-module boundary and are not pure evidence validation. Excluding only installer_managed_apply is insufficient.",
      "recommended_boundary": "Keep both tests excluded from any subsequently authorized Step1-only execution. The seven test methods at lines 29-167 have no managed_apply dependency in their bodies; any later run still needs explicit approval and exact method selection or source separation. No such run or edit was made."
    },
