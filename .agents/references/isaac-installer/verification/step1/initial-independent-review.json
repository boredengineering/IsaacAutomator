    {
      "id": "STEP1-CHAIN-COVERAGE",
      "category": "verification_gap_not_demonstrated_product_bug",
      "severity": "medium",
      "blocking": true,
      "title": "Candidate tests do not themselves establish one nonempty both-adapter concrete-preview acceptance chain",
      "source_refs": [
