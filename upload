import os
import subprocess
import sys
from pathlib import Path

from src.python.file_transfer import host_transfer_invocation, transfer_command

main = transfer_command("push")

if __name__ == "__main__":
    if os.path.exists("/.dockerenv"):
        main()
    else:
        try:
            argv, environment = host_transfer_invocation("push", sys.argv[1:], Path(__file__).resolve().parent)
            raise SystemExit(subprocess.call(argv, env=environment))
        except (ValueError, OSError) as exc:
            print(f"Error: {exc}", file=sys.stderr)
            raise SystemExit(2) from None
