class DeployGCPCommand(DeployCommand):
    """
    Defines options specific for "deploy-gcp" command.
    """

    # gcp instance types capable of running isaac
    GCP_OVKIT_INSTANCE_TYPES = (
        [f"g2-standard-{i}" for i in [4, 8, 12, 16, 24, 32, 48, 96]]
        + [f"n1-standard-{i}" for i in [4, 8, 16, 32, 64, 96]]
        + [f"n1-highmem-{i}" for i in [4, 8, 16, 32, 64, 96]]
        + [f"n1-highcpu-{i}" for i in [16, 32, 64, 96]]
        + [f"a2-highgpu-{i}g" for i in [1, 2, 4, 8]]
        + [f"g4-standard-{i}" for i in [48, 96, 192, 384]]
    )

    @staticmethod
    def project_callback(ctx, param, value):
        if value == "":
            raise click.BadParameter(colorize_error("Project ID cannot be empty"))
        return value

    def __init__(self, *args, **kwargs):
        super().__init__(*args, **kwargs)

        # --zone

        help_message = (
            "Zone (see https://cloud.google.com/compute/docs/gpus/gpu-regions-zones "
            + "for NVIDIA RTX virtual workstations availability)"
        )

        self.params.insert(
            # insert before --isaac option
            self.param_index("isaacsim"),
            click.core.Option(
                ("--zone",),
                prompt=colorize_prompt(f"* {help_message}"),
                callback=lambda ctx, param, value: value.lower(),
                default="us-central1-a",
                show_default=True,
                help=help_message,
            ),
        )

        # --project-id

        help_message = (
            "Project ID (see https://console.cloud.google.com/cloud-resource-manager)"
        )

        self.params.insert(
            # insert after --zone option
            self.param_index("zone") + 1,
            click.core.Option(
                ("--project",),
                callback=self.project_callback,
                default=None,
                help=help_message,
            ),
        )

        # --instance-type

        self.params.insert(
            # insert before --ingress-cidrs option
            self.param_index("ingress_cidrs"),
            click.core.Option(
                (
                    "--instance-type",
                    "--isaac-workstation-instance-type",
                    "isaac_workstation_instance_type",
                ),
                prompt=colorize_prompt(
                    "* Instance Type "
                    + "(see https://cloud.google.com/compute/docs/general-purpose-machines for details)"
                ),
                type=click.Choice(self.GCP_OVKIT_INSTANCE_TYPES),
                show_default=True,
                default=config["gcp_default_isaac_workstation_instance_type"],
                help="Instance type.",
            ),
        )

        # --isaac-workstation-gpu-count

        self.params.insert(
            # insert after --isaac-instance-type option
            self.param_index("isaac_workstation_instance_type") + 1,
            click.core.Option(
                ("--isaac-workstation-gpu-count",),
                prompt=colorize_prompt(
                    "* Isaac Sim: Number of GPUs. N1 - up to 4x NVIDIA T4; "
                    + "G2 - up to 8x NVIDIA L4; G4 - up to 8x NVIDIA RTX PRO 6000 GPUs."
                ),
                show_default=True,
                type=click.Choice(["auto", "1", "2", "4", "8"]),
                default=str(config.get("gcp_default_isaac_workstation_gpu_count", "auto")),
                help="Number of GPUs to attach to Isaac Sim instance (or 'auto' to infer from instance type).",
            ),
        )

        # --flex-start/--no-flex-start

        self.params.insert(
            # insert before --ingress-cidrs option
            self.param_index("ingress_cidrs"),
            click.core.Option(
                ("--flex-start/--no-flex-start",),
                default=False,
                show_default=True,
                help="Deploy using GCP Flex-start (Dynamic Workload Scheduler).",
            ),
        )

        # Independent runtime and local Terraform polling limits. Google 8.2.0
        # has no requestValidForDuration field; create timeout is NOT queue wait.
        self.params.insert(
            self.param_index("flex_start") + 1,
            click.core.Option(
                ("--flex-max-run-seconds",), type=click.IntRange(1, 604800), default=None,
                help="Flex-start VM maximum runtime in seconds (default: 604800).",
            ),
        )
        self.params.insert(
            self.param_index("flex_start") + 2,
            click.core.Option(
                ("--flex-create-timeout-seconds",), type=click.IntRange(1, 86400), default=None,
                help="Flex-start Terraform create timeout in seconds (default: 3600); "
                     "not an allocation wait or cloud cancellation. Allocation-wait "
                     "configuration is unsupported by the pinned Google provider.",
            ),
        )

        # --spot/--no-spot
        self.params.insert(
            self.param_index("flex_start"),
            click.core.Option(
                ("--spot/--no-spot",),
                default=False,
                show_default=True,
                help="Deploy as GCP Spot VM (preemptible with 60-91% discount and automated backup).",
            ),
        )

        # --backup-bucket

        self.params.insert(
            # insert after --flex-start option
            self.param_index("flex_start") + 1,
            click.core.Option(
                ("--backup-bucket",),
                default="",
                show_default=False,
                help="GCS bucket name for continuous checkpoints & preemption backups.",
            ),
        )

        # --auto-restore/--no-auto-restore

        self.params.insert(
            # insert after --backup-bucket option
            self.param_index("backup_bucket") + 1,
            click.core.Option(
                ("--auto-restore/--no-auto-restore",),
                default=False,
                show_default=True,
                help="Automatically restore existing results/checkpoints from GCS on startup.",
            ),
        )


class GCPDeployer(Deployer):
    """
    Deploys stuff to GCP
    """

    cloud = "gcp"

    def resolve_scheduling(self):
        """Resolve profile defaults and reject incompatible scheduling offline."""
        ctx = click.get_current_context(silent=True)
        explicit_flex = ctx and ctx.get_parameter_source("flex_start") in (
            click.core.ParameterSource.COMMANDLINE,
            click.core.ParameterSource.PROMPT,
        )
        prof_spec = self.params.get("profile_spec", {})
        prof_flex = prof_spec.get("enable_flex_start", False) or (
            prof_spec.get("raw", {}).get("security", {}).get("compute", {}).get("scheduling") == "flex_start"
        )
        # Repair uses saved effective values, not this invocation's CLI sources
        # or the defaults of the profile that originally produced the workload.
        if self.existing_behavior != "repair" and not explicit_flex and prof_flex:
            self.params["flex_start"] = True
        if self.params.get("spot", False) and self.params.get("flex_start", False):
            raise click.ClickException("Spot and Flex-start cannot be selected together.")
        for key, maximum in (("flex_max_run_seconds", 604800),
                             ("flex_create_timeout_seconds", 86400)):
            value = self.params.get(key)
            if value is None:
                continue
            if not self.params.get("flex_start", False):
                raise click.ClickException(f"{key} requires Flex-start.")
            if type(value) is not int or not 1 <= value <= maximum:
                raise click.ClickException(f"{key} must be an integer between 1 and {maximum}.")

    def validate_configuration(self):
        if self.existing_behavior != "run_ansible":
            self.resolve_scheduling()
            self.resolve_gpu_count()

    def resolve_gpu_count(self):
        """Resolve and validate GPUs without persistence or cloud discovery."""
        instance_type = self.params["isaac_workstation_instance_type"]
        instance_type_prefix = instance_type[:2]
        ctx = click.get_current_context(silent=True)
        # A restored count is authoritative even when this CLI used defaults.
        explicit_user_gpu_count = self.existing_behavior == "repair"
        if ctx:
            src = ctx.get_parameter_source("isaac_workstation_gpu_count")
            if src in (
                click.core.ParameterSource.COMMANDLINE,
                click.core.ParameterSource.PROMPT,
            ):
                explicit_user_gpu_count = True

        user_gpu_count = self.params.get("isaac_workstation_gpu_count")
        if explicit_user_gpu_count and user_gpu_count and str(user_gpu_count) != "auto":
            gpu_count = int(user_gpu_count)
        elif user_gpu_count and str(user_gpu_count) not in ("auto", "1"):
            gpu_count = int(user_gpu_count)
        else:
            # Infer default GPU count from machine type family
            if instance_type_prefix == "g4":
                if "384" in instance_type:
                    gpu_count = 8
                elif "192" in instance_type:
                    gpu_count = 4
                elif "96" in instance_type:
                    gpu_count = 2
                else:
                    gpu_count = 1
            elif instance_type_prefix == "g2":
                if "96" in instance_type:
                    gpu_count = 8
                elif "48" in instance_type:
                    gpu_count = 4
                elif "24" in instance_type:
                    gpu_count = 2
                else:
                    gpu_count = 1
            elif instance_type_prefix == "a2":
                if "8g" in instance_type:
                    gpu_count = 8
                elif "4g" in instance_type:
                    gpu_count = 4
                elif "2g" in instance_type:
                    gpu_count = 2
                else:
                    gpu_count = 1
            else:
                gpu_count = 1

        if self.params.get("flex_start", False) and instance_type_prefix == "g4":
            expected_gpus = {
                "g4-standard-48": 1, "g4-standard-96": 2,
                "g4-standard-192": 4, "g4-standard-384": 8,
            }[instance_type]
            if gpu_count != expected_gpus:
                raise click.ClickException(
                    f"GPU count for {instance_type} must be {expected_gpus} with Flex-start."
                )
        return gpu_count

    def main(self):
        # Validate restored intent before ask_existing_behavior saves or destroys.
        self._existing_configuration_validator = self.validate_configuration
        self.ask_existing_behavior()

        # Discovery and prompting must wait until backend intent is validated.
        if self.params.get("project") is None:
            self.require_local_backend()
            default_project = shell_command(
                "gcloud config list --format 'value(core.project)'",
                verbose=False,
                exit_on_error=False,
                capture_output=True,
            ).stdout.decode("utf-8").strip()
            self.params["project"] = click.prompt(
                colorize_prompt("* Project ID (see https://console.cloud.google.com/cloud-resource-manager)"),
                default=default_project,
                value_proc=lambda value: DeployGCPCommand.project_callback(None, None, value),
            )
            self.input_params["project"] = self.params["project"]

        if self.existing_behavior != "run_ansible":
            # create tfvars file, deal with existing deployment
            instance_type = self.params["isaac_workstation_instance_type"]
            instance_type_prefix = instance_type[:2]
            boot_disk_type = (
                "hyperdisk-balanced" if instance_type_prefix == "g4" else "pd-ssd"
            )

            gpu_type = {
                "g2": "nvidia-l4",
                "n1": "nvidia-tesla-t4",
                "a2": "nvidia-tesla-a100",
                "g4": "nvidia-rtx-pro-6000",
            }.get(instance_type_prefix, "nvidia-l4")

            gpu_count = self.resolve_gpu_count()

            use_spot = self.params.get("spot", False)
            use_flex_start = self.params.get("flex_start", False)

            backup_bucket = self.params.get("backup_bucket", "")
            if (use_spot or use_flex_start) and (not backup_bucket or backup_bucket == "auto"):
                backup_bucket = f"{self.params['project']}-{self.params['deployment_name']}-backups"
                self.params["backup_bucket"] = backup_bucket
                self.params["auto_restore"] = True

            # Persist resolved scheduling/backup settings before external work
            # (including dry-run); finalization must never save deployment state.
            self.save_meta()

            self.create_tfvars(
                {
                    "zone": self.params["zone"],
                    "project": self.params["project"],
                    "isaac_workstation_gpu_count": gpu_count,
                    "isaac_workstation_gpu_type": gpu_type,
                    "boot_disk_type": boot_disk_type,
                    "use_flex_start": self.params.get("flex_start", False),
                    "use_spot": use_spot,
                    **({
                        "flex_max_run_seconds": self.params.get("flex_max_run_seconds") or 604800,
                        "flex_create_timeout_seconds": self.params.get("flex_create_timeout_seconds") or 3600,
                    } if use_flex_start else {}),
                }
            )


            # login into gcp
            gcp_login(verbose=self.params["debug"])

            if self.params.get("dry_run", False):
                click.echo(colorize_info("\n" + "=" * 70))
                click.echo(colorize_info("* [DRY-RUN] Validating Terraform and Ansible configuration..."))
                click.echo(colorize_info("=" * 70 + "\n"))
                self.initialize_terraform(cwd=f"{config['terraform_dir']}/gcp")
                self.plan_terraform(cwd=f"{config['terraform_dir']}/gcp")
                self.validate_ansible()
                click.echo(colorize_info("\n" + "=" * 70))
                click.echo(colorize_info("* [DRY-RUN] SUCCESS: Terraform plan and Ansible syntax checks passed!"))
                click.echo(colorize_info("* No apply was performed. Planning can read cloud APIs "
                                         "and acquire backend locks; it is not offline validation."))
                click.echo(colorize_info("=" * 70 + "\n"))
                return

            # run terraform
            click.echo(colorize_info("* Running Terraform..."))
            self.initialize_terraform(cwd=f"{config['terraform_dir']}/gcp")
            self.run_terraform(cwd=f"{config['terraform_dir']}/gcp")

        # create ansible inventory file
        self.create_ansible_inventory()

        # export ssh key from terraform
        self.export_ssh_key()

        # save instructions
        self.output_deployment_info(print_text=False)

        # run ansible
        self.run_all_ansible()

        # upload user data
        if self.params["upload"]:
            self.upload_user_data()

        # connection info for the user
        self.output_deployment_info()


@click.command(cls=DeployGCPCommand)
def main(**params):
    GCPDeployer(params, config).main()


if __name__ == "__main__":
    if os.path.exists("/.dockerenv"):
        # we're in docker, run command
        main()
    else:
        # we're outside, start docker container first
        shell_command(f"./run '{' '.join(sys.argv)}'", verbose=True)
