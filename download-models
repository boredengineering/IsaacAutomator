def deployments_callback(ctx, param, value):
    if (value is None) or (value not in deployments()):
        click.echo(
            colorize_error(
                f'Invalid deployment name "{value}". Must be one of: [{", ".join(deployments())}].'
            )
        )
        ctx.abort()
    return value


def profile_callback(ctx, param, value):
    if not value:
        return "complete-model-zoo"
    available = list_model_profiles()
    if value not in available:
        if not Path(value).is_file():
            click.echo(
                colorize_error(
                    f'Invalid model profile "{value}". Available presets: [{", ".join(available)}].'
                )
            )
            ctx.abort()
    return value


def execute_ssh_command(endpoint, cmd_str, check=True):
    """Run a remote shell command via the resolved SSH endpoint."""
    ssh_cmd = [*endpoint.ssh_argv(), f"{endpoint.user}@{endpoint.host}", cmd_str]
    result = subprocess.run(ssh_cmd, shell=False, check=False)
    if check and result.returncode != 0:
        raise click.ClickException(f"Remote command failed with exit code {result.returncode}: {cmd_str}")
    return result


def query_ssh_output(endpoint, cmd_str):
    """Run a remote shell command and return captured stdout string."""
    ssh_cmd = [*endpoint.ssh_argv(), f"{endpoint.user}@{endpoint.host}", cmd_str]
    result = subprocess.run(ssh_cmd, shell=False, capture_output=True, text=True)
    if result.returncode != 0:
        return ""
    return result.stdout.strip()


def _resolve_deployment_models_bucket(meta: dict, explicit_bucket: str | None) -> str | None:
    """Resolve models_bucket ('auto', explicit bucket name, or None) from CLI or deployment profile."""
    params = meta.get("params", {})
    cloud = params.get("cloud", "gcp")
    project = params.get("project")
    prof_name = params.get("profile") or "studio-enterprise"

    bucket_setting = explicit_bucket
    namespace = "studio"
    if not bucket_setting:
        prof_spec = params.get("profile_spec") or {}
        raw_storage = prof_spec.get("raw", {}).get("storage", {})
        bucket_setting = raw_storage.get("models_bucket")
        namespace = raw_storage.get("namespace", "studio")
        if not bucket_setting:
            disk_prof = load_profile_spec(str(prof_name), repo_root=config.get("app_dir")) or {}
            disk_storage = disk_prof.get("raw", {}).get("storage", {})
            bucket_setting = disk_storage.get("models_bucket")
            namespace = disk_storage.get("namespace", namespace)

    if not bucket_setting or str(bucket_setting).lower() in ("none", "no", "local", ""):
        return None

    if str(bucket_setting).lower() == "auto":
        if not project:
            return None
        proposed = propose_models_bucket(cloud=cloud, namespace=namespace, owner_scope=project)
        return proposed["bucket"]

    return str(bucket_setting).replace("gs://", "").replace("s3://", "").strip("/")


def _attach_or_detach_gcp_models_disk(
    *,
    meta: dict,
    outputs: dict,
    endpoint,
    action: str,
    disk_size_gb: int,
    disk_type: str = "hyperdisk-balanced",
    dry_run: bool = False,
):
    """Create & attach (or unmount & delete) the on-demand zonal secondary models disk on GCP."""
    params = meta.get("params", {})
    project = params.get("project")
    zone = params.get("zone")
    prefix = params.get("prefix", "isaacautomator")
    deployment_name = params.get("deployment_name")
    vm_id = outputs.get("isaac_workstation_vm_id") or ""
    vm_name = vm_id.split("/")[-1] if "/" in vm_id else f"{prefix}-{deployment_name}-isaac-workstation-vm"
    disk_name = f"{prefix}-{deployment_name}-isaac-workstation-models"

    if not project or not zone:
        raise click.ClickException("Cannot manage zonal models disk without GCP project and zone in deployment metadata.")

    if action == "detach":
        click.echo(colorize_prompt(f"==> Detaching and deleting zonal models disk '{disk_name}' ({zone})..."))
        if dry_run:
            click.echo(f"  [DRY-RUN] Would unmount /mnt/models_fast on {vm_name}, detach device 'models-fast', and delete disk '{disk_name}'.")
            return
        execute_ssh_command(endpoint, "sudo umount /mnt/models_fast || true", check=False)
        subprocess.run(
            ["gcloud", "compute", "instances", "detach-disk", vm_name, "--device-name=models-fast", f"--zone={zone}", f"--project={project}", "--quiet"],
            check=False,
        )
        subprocess.run(
            ["gcloud", "compute", "disks", "delete", disk_name, f"--zone={zone}", f"--project={project}", "--quiet"],
            check=False,
        )
        click.echo(colorize_info(f"* Zonal models disk '{disk_name}' detached and deleted. Zero idle block disk billing."))
        return

    # Attach flow
    click.echo(colorize_prompt(f"==> Ensuring on-demand zonal models disk '{disk_name}' ({disk_size_gb} GB {disk_type} in {zone})..."))
    if dry_run:
        click.echo(f"  [DRY-RUN] Would create disk '{disk_name}' ({disk_size_gb} GB {disk_type}) and attach as device-name='models-fast' to {vm_name}.")
        return

    desc = subprocess.run(
        ["gcloud", "compute", "disks", "describe", disk_name, f"--zone={zone}", f"--project={project}", "--format=json", "--quiet"],
        capture_output=True, text=True, check=False,
    )
    if desc.returncode != 0:
        click.echo(colorize_info(f"* Creating zonal disk '{disk_name}' ({disk_size_gb} GB, {disk_type})..."))
        subprocess.run(
            [
                "gcloud", "compute", "disks", "create", disk_name,
                f"--size={disk_size_gb}GB",
                f"--type={disk_type}",
                f"--zone={zone}",
                f"--project={project}",
                f"--labels=deployment={deployment_name},managed_by=isaac-automator,purpose=on-demand-zonal-models-fast-disk,mount_point=mnt-models-fast",
                "--quiet",
            ],
            check=True,
        )

    dev_check = query_ssh_output(endpoint, "test -e /dev/disk/by-id/google-models-fast && echo attached || echo missing")
    if dev_check != "attached":
        click.echo(colorize_info(f"* Attaching disk '{disk_name}' to '{vm_name}' as /dev/disk/by-id/google-models-fast..."))
        subprocess.run(
            [
                "gcloud", "compute", "instances", "attach-disk", vm_name,
                f"--disk={disk_name}",
                "--device-name=models-fast",
                f"--zone={zone}",
                f"--project={project}",
                "--quiet",
            ],
            check=True,
        )

    click.echo(colorize_info("* Formatting (if new) and mounting /dev/disk/by-id/google-models-fast at /mnt/models_fast..."))
    mount_script = (
        "sudo mkdir -p /mnt/models_fast && "
        "if ! sudo blkid /dev/disk/by-id/google-models-fast >/dev/null 2>&1; then "
        "  sudo mkfs.ext4 -m 0 -L models_fast /dev/disk/by-id/google-models-fast; "
        "fi && "
        "if ! mountpoint -q /mnt/models_fast; then "
        "  sudo mount -o defaults,noatime,nodiratime,nofail /dev/disk/by-id/google-models-fast /mnt/models_fast; "
        "fi && "
        f"sudo chown -R {endpoint.user}:{endpoint.user} /mnt/models_fast"
    )
    execute_ssh_command(endpoint, mount_script)


@click.command()
@click.argument("deployment_name", required=True, callback=deployments_callback)
@click.option(
    "--profile", "-p",
    default="complete-model-zoo",
    show_default=True,
    help="Model profile name or path from configs/models/",
    callback=profile_callback,
)
@click.option(
    "--models", "-m",
    default="",
    help="Comma-separated subset of model names to provision (e.g. 'gr00t-n1.7-3b,cosmos-reason2-2b'). Empty = all models in profile.",
)
@click.option(
    "--models-bucket",
    default=None,
    help="Permanent cloud object storage bucket ('auto', explicit bucket name, or 'none'). Defaults to profile storage.models_bucket.",
)
@click.option(
    "--attach-disk",
    is_flag=True,
    default=False,
    help="Dynamically create, attach, format, and mount a zonal secondary disk (/mnt/models_fast) sized for the selected models.",
)
@click.option(
    "--detach-disk",
    is_flag=True,
    default=False,
    help="Unmount, detach, and delete the zonal secondary models disk (/mnt/models_fast) to stop block-disk billing while keeping models in GCS.",
)
@click.option(
    "--disk-size-gb",
    type=int,
    default=None,
    help="Explicit size in GB when using --attach-disk (defaults to auto-calculated size with 1.25x headroom).",
)
@click.option(
    "--warmup-ram/--no-warmup-ram",
    default=False,
    show_default=True,
    help="Lock active model weights into Host RAM page cache via vmtouch (28.5 GB/s).",
)
@click.option(
    "--dry-run",
    is_flag=True,
    default=False,
    help="Print the planned actions without downloading models or altering files.",
)
@click.option(
    "--force",
    is_flag=True,
    default=False,
    help="Proceed even if free disk space appears lower than recommended.",
)
@click.option(
    "--debug/--no-debug",
    default=False,
    show_default=True,
)
def main(
    deployment_name: str,
    profile: str,
    models: str,
    models_bucket: str | None,
    attach_disk: bool,
    detach_disk: bool,
    disk_size_gb: int | None,
    warmup_ram: bool,
    dry_run: bool,
    force: bool,
    debug: bool,
):
    """Provision, hydrate from GCS/S3, and configure AI & Robotics models on DEPLOYMENT_NAME."""
    outputs = {
        key: read_tf_output(deployment_name, key, verbose=debug)
        for key in ("cloud", "isaac_workstation_vm_id", "isaac_workstation_ip")
    }
    meta = read_meta(deployment_name, verbose=debug)
    endpoint = endpoint_from_config(
        meta, outputs,
        approved_deployment_path(deployment_name), role="isaac_workstation",
        default_user=config["default_ssh_user"],
    )
    if endpoint.host in ("NA", "", None):
        raise click.ClickException(f'No active workstation VM found for "{deployment_name}".')

    if detach_disk:
        _attach_or_detach_gcp_models_disk(
            meta=meta, outputs=outputs, endpoint=endpoint,
            action="detach", disk_size_gb=0, dry_run=dry_run,
        )
        return

    click.echo(colorize_prompt(f"==> Resolving model profile '{profile}' for {endpoint.user}@{endpoint.host}"))

    selected_list = [x.strip() for x in models.split(",") if x.strip()] if models else None
    resolved_bucket = _resolve_deployment_models_bucket(meta, models_bucket)

    target_home = f"/home/{endpoint.user}" if endpoint.user != "root" else "/root"
    try:
        resolved = resolve_model_profile(
            profile,
            target_user=endpoint.user,
            target_home=target_home,
            selected_models=selected_list,
        )
        plan = generate_download_plan(resolved, models_bucket=resolved_bucket)
    except ModelProfileError as err:
        raise click.ClickException(f"Profile error: {err}")

    target_disk_gb = disk_size_gb or plan["disk_spec"]["recommended_disk_gb"]

    click.echo(f"Profile:       {plan['profile_name']}")
    click.echo(f"Description:   {resolved['description']}")
    click.echo(f"Models:        {len(resolved['models'])} model(s) selected")
    click.echo(f"Required Disk: ~{plan['total_min_disk_gb']} GB raw weights (Recommended Zonal Disk: {target_disk_gb} GB)")
    click.echo(f"Master Bucket: {('gs://' + resolved_bucket) if resolved_bucket else '(disabled — direct Hugging Face Hub only)'}\n")

    # Ensure Permanent Global Models Bucket exists and has human-readable Cloud Console labels + 00-BUCKET-README.md
    params = meta.get("params", {})
    project = params.get("project")
    zone = params.get("zone", "us-central1-b")
    region = "-".join(zone.split("-")[:-1]) if "-" in zone else "us-central1"
    if resolved_bucket and outputs.get("cloud") == "gcp" and project:
        click.echo(colorize_prompt(f"==> Verifying permanent global model archive bucket gs://{resolved_bucket}..."))
        vm_sa = None
        if not dry_run:
            vm_sa = query_ssh_output(endpoint, "gcloud config get-value account 2>/dev/null || true")
        bucket_info = ensure_bucket_self_documented(
            bucket_name=resolved_bucket,
            project=project,
            region=region,
            purpose="ai-models-master-archive",
            namespace="studio",
            profile=str(params.get("profile") or "studio-enterprise"),
            workstation_service_account=vm_sa,
            create_if_missing=True,
            dry_run=dry_run,
        )
        click.echo(colorize_info(f"* Bucket gs://{resolved_bucket} ({bucket_info['status']}) labeled and documented with 00-BUCKET-README.md"))

    # Optional on-demand zonal disk creation & attachment
    if attach_disk and outputs.get("cloud") == "gcp":
        _attach_or_detach_gcp_models_disk(
            meta=meta,
            outputs=outputs,
            endpoint=endpoint,
            action="attach",
            disk_size_gb=target_disk_gb,
            dry_run=dry_run,
        )

    # Pre-flight Disk Check via SSH (check /mnt/models_fast if mounted, else /)
    click.echo(colorize_prompt("==> Checking remote storage space..."))
    df_raw = query_ssh_output(
        endpoint,
        "if mountpoint -q /mnt/models_fast; then df -BG /mnt/models_fast | tail -n 1 | awk '{print $2, $4}' | tr -d 'G'; "
        "else df -BG / | tail -n 1 | awk '{print $2, $4}' | tr -d 'G'; fi"
    )
    total_gb = 0
    avail_gb = 0
    parts = df_raw.split()
    if len(parts) == 2 and parts[0].isdigit() and parts[1].isdigit():
        total_gb = int(parts[0])
        avail_gb = int(parts[1])
        click.echo(f"Target partition capacity: {total_gb} GB total, {avail_gb} GB free")
    else:
        click.echo("Target partition free space: Unknown (could not query df)")

    if total_gb > 0 and total_gb < plan["total_min_disk_gb"] and avail_gb < plan["total_min_disk_gb"] and not attach_disk:
        msg = f"WARNING: Target has {avail_gb} GB free ({total_gb} GB total), but selected models recommend {plan['total_min_disk_gb']} GB."
        if not force and not dry_run:
            click.echo(colorize_error(msg))
            click.echo("Use --attach-disk to dynamically attach a dedicated zonal disk at /mnt/models_fast, or --force to proceed anyway.")
            raise click.Abort()
        else:
            click.echo(colorize_error(f"{msg} Continuing due to --force/--dry-run."))

    # Display Plan
    click.echo(colorize_prompt("\n==> 3-Layer Path Projection & Filesystem Plan:"))
    for dir_path in plan["directories_to_create"]:
        click.echo(f"  [dir]     {dir_path}")
    for link_to, target in plan["symlinks_to_create"]:
        click.echo(f"  [symlink] {target} -> {link_to}")

    click.echo(colorize_prompt("\n==> 3-Tier Model Hydration Commands (Local -> GCS Bucket -> Hugging Face Hub):"))
    for item in plan["download_commands"]:
        click.echo(f"  [{item['model_name']}] {item['hf_command']}" + (f" (cached via {item['gcs_uri']})" if item.get("gcs_uri") else ""))

    if dry_run:
        click.echo(colorize_prompt("\n[Dry Run] No actions performed on remote workstation."))
        return

    # Execute Filesystem Staging & Safe Migration of Existing Directories
    click.echo(colorize_prompt("\n==> Preparing directories and 3-layer path projection symlinks on workstation..."))
    for dir_path in plan["directories_to_create"]:
        if dir_path in ("/", "/mnt", "/opt", "/home"):
            continue
        if dir_path.startswith("/models"):
            setup_cmd = f"sudo mkdir -p '{dir_path}' && sudo chown -R {endpoint.user}:{endpoint.user} /models"
        elif dir_path.startswith("/mnt/models_fast"):
            setup_cmd = f"sudo mkdir -p '{dir_path}' && sudo chown -R {endpoint.user}:{endpoint.user} /mnt/models_fast"
        elif dir_path.startswith(("/mnt", "/opt")):
            setup_cmd = f"sudo mkdir -p '{dir_path}' && sudo chown -R {endpoint.user}:{endpoint.user} '{dir_path}'"
        else:
            setup_cmd = f"mkdir -p '{dir_path}'"
        execute_ssh_command(endpoint, setup_cmd)

    for link_to, target in plan["symlinks_to_create"]:
        parent_dir = str(Path(target).parent)
        link_cmd = (
            f"sudo mkdir -p '{parent_dir}' '{link_to}' && "
            f"sudo chown -R {endpoint.user}:{endpoint.user} '{link_to}' && "
            f"if [ -d '{target}' ] && [ ! -L '{target}' ]; then "
            f"  cp -rn '{target}/.' '{link_to}/' 2>/dev/null || true; "
            f"  sudo rm -rf '{target}'; "
            f"fi && "
            f"sudo ln -sfn '{link_to}' '{target}' && "
            f"sudo chown -h {endpoint.user}:{endpoint.user} '{target}'"
        )
        execute_ssh_command(endpoint, link_cmd)

    # Write programmatic /etc/isaac-models.env and /etc/profile.d/isaac-models.sh
    env_content = plan["env_file_content"]
    write_env_cmd = (
        f"cat << 'EOF' | sudo tee /etc/isaac-models.env /etc/profile.d/isaac-models.sh >/dev/null\n"
        f"{env_content}"
        f"EOF\n"
        f"sudo chmod 0644 /etc/isaac-models.env /etc/profile.d/isaac-models.sh"
    )
    execute_ssh_command(endpoint, write_env_cmd)

    # Execute 3-Tier Waterfall Downloads
    click.echo(colorize_prompt("\n==> Provisioning models (3-Tier Waterfall: Local -> GCS Archive -> HF Hub)..."))
    succeeded_models = []
    skipped_gated_models = []
    for item in plan["download_commands"]:
        click.echo(colorize_prompt(f"\n--- Provisioning '{item['model_name']}' ({item['repo_id']}) ---"))
        cmd = item["command"]
        full_remote_cmd = f"bash -l -c \"{cmd}\""
        res = execute_ssh_command(endpoint, full_remote_cmd, check=False)
        if res.returncode == 0:
            succeeded_models.append(item["model_name"])
        else:
            skipped_gated_models.append(f"{item['model_name']} ({item['repo_id']})")
            click.echo(
                colorize_error(
                    f"* Warning: '{item['model_name']}' ({item['repo_id']}) failed or requires HF_TOKEN authentication. Continuing with remaining models..."
                )
            )

    # Optional Host RAM Pool Warmup via vmtouch (capped at 120 GB so 192 GB Host RAM never thrashes)
    if warmup_ram:
        click.echo(colorize_prompt("\n==> Warming active model weights into Host RAM page cache (vmtouch, max 120 GB budget)..."))
        warmed_gb = 0
        eligible = [
            item for item in plan["download_commands"]
            if item["model_name"] in succeeded_models and item["min_disk_free_gb"] <= 80
        ]
        # Warm smallest real-time policies & visual critics first, then primary spec LLM
        for item in sorted(eligible, key=lambda x: x["min_disk_free_gb"]):
            if warmed_gb + item["min_disk_free_gb"] > 120:
                continue
            execute_ssh_command(
                endpoint,
                f"sudo apt-get install -y vmtouch >/dev/null 2>&1 || true; vmtouch -t -q '{item['destination']}' || true",
                check=False,
            )
            warmed_gb += item["min_disk_free_gb"]
            click.echo(colorize_info(f"* Warmed '{item['model_name']}' (~{item['min_disk_free_gb']} GB) into Host RAM page cache."))

    click.echo(colorize_prompt(f"\n==> Provisioning Summary: {len(succeeded_models)}/{len(plan['download_commands'])} models provisioned and archived to GCS!"))
    if skipped_gated_models:
        click.echo(
            colorize_error(
                f"* Skipped / Gated models requiring HF_TOKEN: {', '.join(skipped_gated_models)}"
            )
        )


if __name__ == "__main__":
    if os.path.exists("/.dockerenv"):
        main()
    else:
        shell_command(f"./run '{' '.join(sys.argv)}'", verbose=True)
