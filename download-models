import click

from src.python.config import c as config, load_profile_spec
from src.python.file_transfer import endpoint_from_config
from src.python.model_profile import (
    list_model_profiles,
    resolve_model_profile,
    generate_download_plan,
    propose_models_bucket,
    ensure_bucket_self_documented,
    ModelProfileError,
)
from src.python.utils import (
    approved_deployment_path,
