#!/usr/bin/env python3
"""Container-aware backend commands with explicit durable admin-state transport."""
import os
from pathlib import Path
import shlex
import subprocess
import sys


def host_arguments(arguments):
    """Map an explicitly supplied bootstrap root, without opening any contents."""
    rewritten = []
    environment = dict(os.environ)
    seen_root = False
    index = 0
    while index < len(arguments):
        item = arguments[index]
        if item == "--bootstrap-state-root" or item.startswith("--bootstrap-state-root="):
            if seen_root:
                raise SystemExit("Only one bootstrap state root may be selected")
            seen_root = True
            if "=" in item:
                value = item.split("=", 1)[1]
            else:
                index += 1
                if index >= len(arguments):
                    raise SystemExit("Missing bootstrap state root")
                value = arguments[index]
            if not value or not Path(value).is_absolute():
                raise SystemExit("Bootstrap state root must be an absolute host directory")
            environment["ISAAC_BOOTSTRAP_STATE_ROOT"] = value
            rewritten.extend(["--bootstrap-state-root", "/run/isaac-bootstrap-state"])
        else:
            rewritten.append(item)
        index += 1
    return rewritten, environment


if __name__ == "__main__":
    root = Path(__file__).resolve().parent
    if os.path.exists("/.dockerenv"):
        from src.python.state_backend_command import main
        main()
    else:
        arguments, environment = host_arguments(sys.argv[1:])
        result = subprocess.run(
            [str(root / "run"), shlex.join(["./state-backend", *arguments])],
            check=False, env=environment,
        )
        sys.exit(result.returncode)
