+package scraper
+
+import (
+	"context"
+	"errors"
+	"net/http"
+	"strings"
+	"testing"
+
+	"github.com/c3xdev/c3x-pricing-api/internal/config"
+)
+
+func TestGCPCatalogOriginAndRedirects(t *testing.T) {
+	for _, mode := range []string{"api_key", "adc"} {
+		for _, target := range []string{"http://cloudbilling.googleapis.com/v1/services", "https://evil.example/v1/services", "https://cloudbilling.googleapis.com.evil.example/v1/services", "https://cloudbilling.googleapis.com:443/v1/services", "https://user@cloudbilling.googleapis.com/v1/services", "https://cloudbilling.googleapis.com/v1/services#fragment"} {
+			t.Run(mode+"/"+target, func(t *testing.T) {
+				s := testAuthenticatedScraper(mode)
+				calls := 0
+				s.client.Transport = catalogTransport(func(r *http.Request) (*http.Response, error) { calls++; return catalogResponse(200, `{}`), nil })
+				resp, err := s.catalogRequest(context.Background(), target)
+				if resp != nil {
+					resp.Body.Close()
+				}
+				if err == nil || calls != 0 {
+					t.Fatalf("unsafe origin accepted: error=%v calls=%d", err, calls)
+				}
+			})
+		}
+		for _, location := range []string{"https://evil.example/secret", "http://cloudbilling.googleapis.com/secret", "https://cloudbilling.googleapis.com/secret"} {
+			t.Run(mode+"/redirect/"+location, func(t *testing.T) {
+				s := testAuthenticatedScraper(mode)
+				calls := 0
+				s.client.Transport = catalogTransport(func(r *http.Request) (*http.Response, error) {
+					calls++
+					if calls > 1 {
+						return catalogResponse(200, `{}`), nil
+					}
+					resp := catalogResponse(302, "sensitive-body")
+					resp.Header.Set("Location", location)
+					return resp, nil
+				})
+				resp, err := s.catalogRequest(context.Background(), gcpBaseURL+"/services")
+				if resp != nil {
+					resp.Body.Close()
+				}
+				if err == nil || calls != 1 {
+					t.Fatalf("redirect followed: error=%v calls=%d", err, calls)
+				}
+			})
+		}
+	}
+}
+
+func TestGCPCatalogTransportErrorRedacted(t *testing.T) {
+	s := testAuthenticatedScraper("adc")
+	s.client.Transport = catalogTransport(func(r *http.Request) (*http.Response, error) { return nil, errors.New("sensitive-token-and-headers") })
+	_, err := s.catalogRequest(context.Background(), gcpBaseURL+"/services")
+	if err == nil || strings.Contains(err.Error(), "sensitive") {
+		t.Fatalf("transport error not redacted: %v", err)
+	}
+}
+
+func TestGCPQuotaHeaderInjectionRejected(t *testing.T) {
+	s := NewGCPScraper(&config.Config{GCPAPIKey: "test-key", GCPQuotaProject: "project\r\nInjected: sensitive"})
+	if err := s.Preflight(context.Background()); err == nil || strings.Contains(err.Error(), "sensitive") {
+		t.Fatalf("bad quota accepted/leaked: %v", err)
+	}
+}
