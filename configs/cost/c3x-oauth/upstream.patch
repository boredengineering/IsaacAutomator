@@ -0,0 +1,68 @@
+package scraper
+
+import (
+	"context"
+	"errors"
+	"net/http"
+	"strings"
+	"testing"
+)
+
+func TestGCPAuthFailureNotSwallowed(t *testing.T) {
+	for _, endpoint := range []string{"services", "skus"} {
+		for _, status := range []int{400, 401, 403} {
+			t.Run(endpoint+http.StatusText(status), func(t *testing.T) {
+				s := testAuthenticatedScraper("api_key")
+				s.client.Transport = catalogTransport(func(r *http.Request) (*http.Response, error) {
+					if endpoint == "services" || strings.HasSuffix(r.URL.Path, "/skus") {
+						return catalogResponse(status, "sensitive-body"), nil
+					}
+					return catalogResponse(200, `{}`), nil
+				})
+				_, err := s.Scrape(context.Background())
+				if err == nil || strings.Contains(err.Error(), "sensitive") {
+					t.Fatalf("auth error swallowed or leaked: %v", err)
+				}
+			})
+		}
+	}
+}
+
+func TestGCPResponseErrorsRedacted(t *testing.T) {
+	for _, endpoint := range []string{"services", "skus"} {
+		for _, kind := range []string{"status", "json", "read"} {
+			t.Run(endpoint+"/"+kind, func(t *testing.T) {
+				s := testAuthenticatedScraper("api_key")
+				s.client.Transport = catalogTransport(func(r *http.Request) (*http.Response, error) {
+					switch kind {
+					case "status":
+						return catalogResponse(403, "sensitive-response-body"), nil
+					case "json":
+						return catalogResponse(200, `sensitive-invalid-json`), nil
+					default:
+						resp := catalogResponse(200, "")
+						resp.Body = failingCatalogBody{}
+						return resp, nil
+					}
+				})
+				var err error
+				if endpoint == "services" {
+					_, err = s.resolveDiscoverableServices(context.Background())
+				} else {
+					_, err = s.fetchGCPPage(context.Background(), "test-service", "")
+				}
+				if err == nil || strings.Contains(err.Error(), "sensitive") {
+					t.Fatalf("response error swallowed/leaked: %v", err)
+				}
+				if kind != "status" && err.Error() != "GCP catalog response invalid" {
+					t.Fatalf("expected fully sanitized decoding/read error, got %v", err)
+				}
+			})
+		}
+	}
+}
+
+type failingCatalogBody struct{}
+
+func (failingCatalogBody) Read([]byte) (int, error) { return 0, errors.New("sensitive-read-error") }
+func (failingCatalogBody) Close() error             { return nil }
