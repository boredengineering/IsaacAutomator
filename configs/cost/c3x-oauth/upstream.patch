diff --git a/cmd/gcp-catalog-probe/main.go b/cmd/gcp-catalog-probe/main.go
new file mode 100644
index 0000000..96bc249
--- /dev/null
+++ b/cmd/gcp-catalog-probe/main.go
@@ -0,0 +1,43 @@
+package main
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"os/signal"
+	"syscall"
+
+	"github.com/c3xdev/c3x-pricing-api/internal/config"
+	"github.com/c3xdev/c3x-pricing-api/internal/scraper"
+)
+
+func main() {
+	ctx, cancel := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
+	defer cancel()
+	// The closure is not invoked until --live is explicitly supplied.
+	err := run(ctx, os.Args[1:], os.Stdout, func(ctx context.Context) (int, int, error) {
+		return scraper.NewGCPScraper(config.Load()).ProbeCatalog(ctx)
+	})
+	if err != nil {
+		fmt.Fprintln(os.Stderr, err)
+		os.Exit(1)
+	}
+}
+
+func run(ctx context.Context, args []string, out io.Writer, probe func(context.Context) (int, int, error)) error {
+	if len(args) != 1 || args[0] != "--live" {
+		return errors.New("opt-in required: gcp-catalog-probe --live (two read-only catalog requests)")
+	}
+	services, skus, err := probe(ctx)
+	if err != nil {
+		return err
+	}
+	return json.NewEncoder(out).Encode(struct {
+		Status   string `json:"status"`
+		Services int    `json:"services"`
+		SKUs     int    `json:"compute_engine_skus"`
+	}{"ok", services, skus})
+}
diff --git a/cmd/gcp-catalog-probe/main_test.go b/cmd/gcp-catalog-probe/main_test.go
new file mode 100644
index 0000000..b84570f
--- /dev/null
+++ b/cmd/gcp-catalog-probe/main_test.go
@@ -0,0 +1,36 @@
+package main
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"strings"
+	"testing"
+)
+
+func TestProbeRequiresExplicitOptIn(t *testing.T) {
+	for _, args := range [][]string{nil, {"--unknown-sensitive"}, {"--live", "extra"}} {
+		var out bytes.Buffer
+		err := run(context.Background(), args, &out, func(context.Context) (int, int, error) { t.Fatal("probe ran without opt-in"); return 0, 0, nil })
+		if err == nil || !strings.Contains(err.Error(), "--live") || strings.Contains(err.Error(), "sensitive") || out.Len() != 0 {
+			t.Fatalf("unsafe opt-in result: %v", err)
+		}
+	}
+}
+
+func TestProbePrintsOnlyCounts(t *testing.T) {
+	var out bytes.Buffer
+	err := run(context.Background(), []string{"--live"}, &out, func(context.Context) (int, int, error) { return 1, 1, nil })
+	if err != nil || out.String() != "{\"status\":\"ok\",\"services\":1,\"compute_engine_skus\":1}\n" {
+		t.Fatalf("unexpected result: %s %v", out.String(), err)
+	}
+}
+
+func TestProbeFailureHasNoSuccessOutput(t *testing.T) {
+	var out bytes.Buffer
+	want := errors.New("GCP catalog HTTP 403")
+	err := run(context.Background(), []string{"--live"}, &out, func(context.Context) (int, int, error) { return 1, 0, want })
+	if !errors.Is(err, want) || out.Len() != 0 {
+		t.Fatalf("error lost/false success: %s %v", out.String(), err)
+	}
+}
diff --git a/cmd/server/gcp_auth_test.go b/cmd/server/gcp_auth_test.go
new file mode 100644
index 0000000..b42c9dd
--- /dev/null
+++ b/cmd/server/gcp_auth_test.go
@@ -0,0 +1,30 @@
+package main
+
+import (
+	"context"
+	"strings"
+	"testing"
+)
+
+func TestScrapeGCPAuthBeforeDatabase(t *testing.T) {
+	for _, vendor := range []string{"gcp", "all"} {
+		for _, mode := range []string{"api_key", "invalid-sensitive"} {
+			t.Run(vendor+"/"+mode, func(t *testing.T) {
+				t.Setenv("GCP_AUTH_MODE", mode)
+				t.Setenv("GCP_API_KEY", "")
+				t.Setenv("GCP_QUOTA_PROJECT", "")
+				t.Setenv("DATABASE_URL", "://invalid")
+				cmd := scrapeCmd()
+				cmd.SetArgs([]string{"--vendor", vendor})
+				err := cmd.ExecuteContext(context.Background())
+				want := "GCP_API_KEY"
+				if mode != "api_key" {
+					want = "GCP_AUTH_MODE"
+				}
+				if err == nil || !strings.Contains(err.Error(), want) || strings.Contains(err.Error(), "sensitive") {
+					t.Fatalf("auth must fail before DB: %v", err)
+				}
+			})
+		}
+	}
+}
