index 0000000..1232b4d
--- /dev/null
+++ b/internal/scraper/gcp_probe.go
@@ -0,0 +1,32 @@
+package scraper
+
+import (
+	"context"
+	"time"
+)
+
+// ProbeCatalog makes at most two catalog calls (no retries/pagination), using
+// exactly the same auth/origin/response helpers as the importer. It does not
+// touch a DB or transform products. Only counts escape the response boundary.
+func (s *GCPScraper) ProbeCatalog(ctx context.Context) (services, skus int, err error) {
+	ctx, cancel := context.WithTimeout(ctx, 60*time.Second)
+	defer cancel()
+	if err = s.Preflight(ctx); err != nil {
+		return
+	}
+	var servicePage struct {
+		Services []struct{} `json:"services"`
+	}
+	if err = s.catalogJSON(ctx, gcpBaseURL+"/services?pageSize=1", &servicePage); err != nil {
+		return
+	}
+	services = len(servicePage.Services)
+	var skuPage struct {
+		SKUs []struct{} `json:"skus"`
+	}
+	if err = s.catalogJSON(ctx, gcpBaseURL+"/services/6F81-5844-456A/skus?pageSize=1", &skuPage); err != nil {
+		return
+	}
+	skus = len(skuPage.SKUs)
+	return
+}
diff --git a/internal/scraper/gcp_probe_test.go b/internal/scraper/gcp_probe_test.go
new file mode 100644
index 0000000..92339ea
--- /dev/null
+++ b/internal/scraper/gcp_probe_test.go
@@ -0,0 +1,64 @@
+package scraper
+
+import (
+	"context"
+	"net/http"
+	"strings"
+	"testing"
+)
+
+type boundedCatalogProbe interface {
+	ProbeCatalog(context.Context) (int, int, error)
+}
+
+func TestGCPBoundedCatalogProbe(t *testing.T) {
+	s := testAuthenticatedScraper("adc")
+	probe, ok := any(s).(boundedCatalogProbe)
+	if !ok {
+		t.Fatal("bounded catalog probe is not implemented")
+	}
+	calls := 0
+	s.client.Transport = catalogTransport(func(r *http.Request) (*http.Response, error) {
+		calls++
+		if calls > 2 {
+			t.Fatal("probe followed pagination or retried")
+		}
+		if r.Header.Get("Authorization") != "Bearer test-token" || r.Header.Get("X-Goog-User-Project") != "quota-project" {
+			t.Error("probe did not use production auth")
+		}
+		if r.URL.Query().Get("pageSize") != "1" || r.URL.Query().Get("pageToken") != "" {
+			t.Error("probe request not bounded")
+		}
+		if calls == 1 {
+			if r.URL.Path != "/v1/services" {
+				t.Error("wrong services path")
+			}
+			return catalogResponse(200, `{"services":[{"serviceId":"test"}],"nextPageToken":"ignored"}`), nil
+		}
+		if r.URL.Path != "/v1/services/6F81-5844-456A/skus" {
+			t.Error("wrong Compute Engine path")
+		}
+		return catalogResponse(200, `{"skus":[{"skuId":"test"}],"nextPageToken":"ignored"}`), nil
+	})
+	services, skus, err := probe.ProbeCatalog(context.Background())
+	if err != nil || services != 1 || skus != 1 || calls != 2 {
+		t.Fatalf("probe result: services=%d skus=%d calls=%d err=%v", services, skus, calls, err)
+	}
+}
+
+func TestGCPProbeStopsOnError(t *testing.T) {
+	s := testAuthenticatedScraper("api_key")
+	probe, ok := any(s).(boundedCatalogProbe)
+	if !ok {
+		t.Fatal("bounded catalog probe is not implemented")
+	}
+	calls := 0
+	s.client.Transport = catalogTransport(func(r *http.Request) (*http.Response, error) {
+		calls++
+		return catalogResponse(403, "sensitive-body"), nil
+	})
+	_, _, err := probe.ProbeCatalog(context.Background())
+	if err == nil || strings.Contains(err.Error(), "sensitive") || calls != 1 {
+		t.Fatalf("unbounded/unsafe failed probe: calls=%d err=%v", calls, err)
+	}
+}
diff --git a/internal/scraper/gcp_refresh_test.go b/internal/scraper/gcp_refresh_test.go
new file mode 100644
index 0000000..44afd6f
--- /dev/null
+++ b/internal/scraper/gcp_refresh_test.go
@@ -0,0 +1,234 @@
+package scraper
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"net/http"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/c3xdev/c3x-pricing-api/internal/config"
+	"golang.org/x/oauth2"
+)
+
+type catalogTokenFunc func() (*oauth2.Token, error)
+
+func (f catalogTokenFunc) Token() (*oauth2.Token, error) { return f() }
+
+func TestGCPADCRejectsInvalidTokens(t *testing.T) {
+	for _, token := range []*oauth2.Token{{}, {AccessToken: "sensitive", Expiry: time.Now().Add(-time.Hour)}, {AccessToken: "sensitive\r\nInjected: value"}} {
+		s := testAuthenticatedScraper("adc")
+		s.findTokenSource = func(context.Context, string) (oauth2.TokenSource, error) {
+			return catalogTokenFunc(func() (*oauth2.Token, error) { return token, nil }), nil
+		}
+		if err := s.Preflight(context.Background()); !errors.Is(err, errGCPAuth) || strings.Contains(err.Error(), "sensitive") {
+			t.Fatalf("invalid token accepted or leaked: %v", err)
+		}
+	}
+}
+
+func TestGCPMissingKeyDoesNotDiscoverADC(t *testing.T) {
+	for _, mode := range []string{"", "api_key"} {
+		s := NewGCPScraper(&config.Config{GCPAuthMode: mode})
+		s.findTokenSource = func(context.Context, string) (oauth2.TokenSource, error) {
+			t.Fatal("API key mode consulted ADC")
+			return nil, nil
+		}
+		if err := s.Preflight(context.Background()); err == nil || !strings.Contains(err.Error(), "GCP_API_KEY") {
+			t.Fatalf("missing key not rejected: %v", err)
+		}
+	}
+}
+
+func TestGCPADCFailureDoesNotFallback(t *testing.T) {
+	for _, stage := range []string{"discovery", "refresh"} {
+		s := testAuthenticatedScraper("adc") // deliberately also has a key
+		s.findTokenSource = func(context.Context, string) (oauth2.TokenSource, error) {
+			if stage == "discovery" {
+				return nil, errors.New("sensitive-file-path-oauth-body")
+			}
+			return catalogTokenFunc(func() (*oauth2.Token, error) { return nil, errors.New("sensitive-refresh-body") }), nil
+		}
+		s.client.Transport = catalogTransport(func(*http.Request) (*http.Response, error) { t.Fatal("ADC failure fell back to key"); return nil, nil })
+		if _, err := s.Scrape(context.Background()); !errors.Is(err, errGCPAuth) || strings.Contains(err.Error(), "sensitive") {
+			t.Fatalf("unsafe auth error: %v", err)
+		}
+	}
+}
+
+func TestGCPADCDiscoveryCancellation(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	s := testAuthenticatedScraper("adc")
+	s.findTokenSource = func(ctx context.Context, _ string) (oauth2.TokenSource, error) { cancel(); return nil, ctx.Err() }
+	if err := s.Preflight(ctx); !errors.Is(err, context.Canceled) {
+		t.Fatalf("lost discovery cancellation: %v", err)
+	}
+}
+
+func TestGCPADCRefreshAndConcurrentReuse(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	s := testAuthenticatedScraper("adc")
+	var refreshes atomic.Int32
+	s.findTokenSource = func(lifetime context.Context, _ string) (oauth2.TokenSource, error) {
+		if lifetime != ctx {
+			t.Error("source was not bound to scrape lifetime")
+		}
+		// Exercise the official refresh implementation with a fake HTTP transport.
+		oauthClient := &http.Client{CheckRedirect: rejectGCPRedirect, Transport: catalogTransport(func(r *http.Request) (*http.Response, error) {
+			n := refreshes.Add(1)
+			if r.URL.String() != "https://oauth2.googleapis.com/token" || r.Method != http.MethodPost {
+				t.Error("wrong refresh request")
+			}
+			resp := catalogResponse(200, fmt.Sprintf(`{"access_token":"fake-refreshed-%d","token_type":"Bearer","expires_in":3600}`, n))
+			resp.Header.Set("Content-Type", "application/json")
+			return resp, nil
+		})}
+		tokenCtx := context.WithValue(lifetime, oauth2.HTTPClient, oauthClient)
+		cfg := &oauth2.Config{ClientID: "fake-client", Endpoint: oauth2.Endpoint{TokenURL: "https://oauth2.googleapis.com/token", AuthStyle: oauth2.AuthStyleInParams}}
+		return cfg.TokenSource(tokenCtx, &oauth2.Token{RefreshToken: "fake-refresh"}), nil
+	}
+	if err := s.Preflight(ctx); err != nil {
+		t.Fatal(err)
+	}
+	first, err := s.auth.source.Token()
+	if err != nil {
+		t.Fatal(err)
+	}
+	first.Expiry = time.Now().Add(-time.Hour) // expire before starting concurrent requests
+	s.client.Transport = catalogTransport(func(r *http.Request) (*http.Response, error) {
+		if r.Header.Get("Authorization") != "Bearer fake-refreshed-2" {
+			t.Error("expired token reused")
+		}
+		return catalogResponse(200, `{}`), nil
+	})
+	var wg sync.WaitGroup
+	for i := 0; i < 8; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			resp, err := s.catalogRequest(ctx, gcpBaseURL+"/services")
+			if err != nil {
+				t.Error(err)
+				return
+			}
+			resp.Body.Close()
+		}()
+	}
+	wg.Wait()
+	if n := refreshes.Load(); n != 2 {
+		t.Fatalf("refreshes=%d, expected cached initial + one refresh", n)
+	}
+}
+
+func TestGCPADCCancellationDuringRefresh(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	started := make(chan struct{})
+	s := testAuthenticatedScraper("adc")
+	s.findTokenSource = func(lifetime context.Context, _ string) (oauth2.TokenSource, error) {
+		return catalogTokenFunc(func() (*oauth2.Token, error) {
+			close(started)
+			<-lifetime.Done()
+			return nil, errors.New("sensitive-canceled-refresh")
+		}), nil
+	}
+	done := make(chan error, 1)
+	go func() { done <- s.Preflight(ctx) }()
+	<-started
+	cancel()
+	select {
+	case err := <-done:
+		if !errors.Is(err, context.Canceled) {
+			t.Fatalf("lost refresh cancellation: %v", err)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("refresh did not cancel")
+	}
+}
+
+func TestGCPChildCancellationDuringSharedRefresh(t *testing.T) {
+	root, cancelRoot := context.WithCancel(context.Background())
+	defer cancelRoot()
+	child, cancelChild := context.WithCancel(root)
+	defer cancelChild()
+	started, release := make(chan struct{}), make(chan struct{})
+	s := testAuthenticatedScraper("adc")
+	first := &oauth2.Token{AccessToken: "first", Expiry: time.Now().Add(time.Hour)}
+	count := 0
+	s.findTokenSource = func(lifetime context.Context, _ string) (oauth2.TokenSource, error) {
+		if lifetime != root {
+			t.Error("refresh source did not retain root context")
+		}
+		return catalogTokenFunc(func() (*oauth2.Token, error) {
+			count++
+			if count == 1 {
+				return first, nil
+			}
+			close(started)
+			<-release
+			return &oauth2.Token{AccessToken: "second"}, nil
+		}), nil
+	}
+	if err := s.Preflight(root); err != nil {
+		t.Fatal(err)
+	}
+	first.Expiry = time.Now().Add(-time.Hour)
+	done := make(chan error, 1)
+	go func() { done <- s.Preflight(child) }()
+	<-started
+	cancelChild()
+	select {
+	case err := <-done:
+		if !errors.Is(err, context.Canceled) {
+			t.Errorf("lost child cancellation: %v", err)
+		}
+		close(release)
+	case <-time.After(200 * time.Millisecond):
+		close(release)
+		<-done
+		t.Fatal("child cancellation waited for unrelated root-context refresh")
+	}
+}
+
+func TestGCPOAuthRefreshRedirectRedacted(t *testing.T) {
+	s := testAuthenticatedScraper("adc")
+	calls := 0
+	s.findTokenSource = func(ctx context.Context, _ string) (oauth2.TokenSource, error) {
+		client := &http.Client{CheckRedirect: rejectGCPRedirect, Transport: catalogTransport(func(r *http.Request) (*http.Response, error) {
+			calls++
+			if calls > 1 {
+				t.Error("OAuth redirect followed")
+			}
+			resp := catalogResponse(302, "sensitive-refresh-body")
+			resp.Header.Set("Location", "https://evil.example/sensitive-refresh-token")
+			return resp, nil
+		})}
+		ctx = context.WithValue(ctx, oauth2.HTTPClient, client)
+		cfg := &oauth2.Config{ClientID: "fake-client", Endpoint: oauth2.Endpoint{TokenURL: "https://oauth2.googleapis.com/token", AuthStyle: oauth2.AuthStyleInParams}}
+		return cfg.TokenSource(ctx, &oauth2.Token{RefreshToken: "fake-refresh"}), nil
+	}
+	err := s.Preflight(context.Background())
+	if !errors.Is(err, errGCPAuth) || strings.Contains(err.Error(), "sensitive") || calls != 1 {
+		t.Fatalf("unsafe OAuth redirect: calls=%d err=%v", calls, err)
+	}
+}
+
+func TestGCPCatalogCancellation(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	s := testAuthenticatedScraper("adc")
+	s.client.Transport = catalogTransport(func(r *http.Request) (*http.Response, error) {
+		cancel()
+		<-r.Context().Done()
+		return nil, errors.New("sensitive-request-error")
+	})
+	if _, err := s.catalogRequest(ctx, gcpBaseURL+"/services"); !errors.Is(err, context.Canceled) {
+		t.Fatalf("lost HTTP cancellation: %v", err)
+	}
+}
