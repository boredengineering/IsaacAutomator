+package scraper
+
+import (
+	"context"
+	"io"
+	"net/http"
+	"strings"
+	"testing"
+
+	"github.com/c3xdev/c3x-pricing-api/internal/config"
+	"golang.org/x/oauth2"
+)
+
+func testAuthenticatedScraper(mode string) *GCPScraper {
+	s := NewGCPScraper(&config.Config{GCPAuthMode: mode, GCPAPIKey: "test-key", GCPQuotaProject: "quota-project"})
+	s.findTokenSource = func(context.Context, string) (oauth2.TokenSource, error) {
+		return oauth2.StaticTokenSource(&oauth2.Token{AccessToken: "test-token"}), nil
+	}
+	return s
+}
+
+type catalogTransport func(*http.Request) (*http.Response, error)
+
+func (f catalogTransport) RoundTrip(r *http.Request) (*http.Response, error) { return f(r) }
+func catalogResponse(status int, body string) *http.Response {
+	return &http.Response{StatusCode: status, Header: make(http.Header), Body: io.NopCloser(strings.NewReader(body))}
+}
+func TestGCPInvalidModeDoesNotScrape(t *testing.T) {
+	s := NewGCPScraper(&config.Config{GCPAPIKey: "test-key-sensitive", GCPAuthMode: "invalid-sensitive"})
+	calls := 0
+	s.client.Transport = catalogTransport(func(r *http.Request) (*http.Response, error) {
+		calls++
+		return catalogResponse(200, `{}`), nil
+	})
+	_, err := s.Scrape(context.Background())
+	if err == nil || !strings.Contains(err.Error(), "GCP_AUTH_MODE") || strings.Contains(err.Error(), "sensitive") {
+		t.Fatalf("expected safe invalid mode error, got %v", err)
+	}
+	if calls != 0 {
+		t.Fatalf("invalid mode made %d catalog calls", calls)
+	}
+}
+
+// Injecting a source keeps this suite entirely independent of ADC files/metadata.
+func TestGCPADCOnBothCatalogEndpoints(t *testing.T) {
+	s := NewGCPScraper(&config.Config{GCPAuthMode: "adc", GCPAPIKey: "must-not-fallback", GCPQuotaProject: "quota-project"})
+	s.findTokenSource = func(ctx context.Context, scope string) (oauth2.TokenSource, error) {
+		if scope != "https://www.googleapis.com/auth/cloud-billing.readonly" {
+			t.Fatalf("wrong scope %q", scope)
+		}
+		return oauth2.StaticTokenSource(&oauth2.Token{AccessToken: "test-oauth-sensitive"}), nil
+	}
+	services, skus := 0, 0
+	s.client.Transport = catalogTransport(func(r *http.Request) (*http.Response, error) {
+		if r.Header.Get("Authorization") != "Bearer test-oauth-sensitive" || r.Header.Get("X-Goog-Api-Key") != "" || r.Header.Get("X-Goog-User-Project") != "quota-project" {
+			t.Error("incorrect ADC headers")
+		}
+		if strings.HasSuffix(r.URL.Path, "/skus") {
+			skus++
+		} else {
+			services++
+		}
+		return catalogResponse(200, `{}`), nil
+	})
+	if _, err := s.Scrape(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+	if services != 1 || skus != len(gcpServices) {
+		t.Fatalf("calls services=%d skus=%d", services, skus)
+	}
+}
+
+func TestGCPAPIKeyPreservedOnBothEndpoints(t *testing.T) {
+	for _, mode := range []string{"", "api_key"} {
+		s := testAuthenticatedScraper(mode)
+		s.findTokenSource = func(context.Context, string) (oauth2.TokenSource, error) {
+			t.Error("key mode discovered ADC")
+			return nil, nil
+		}
+		calls := 0
+		s.client.Transport = catalogTransport(func(r *http.Request) (*http.Response, error) {
+			calls++
+			if r.Header.Get("X-Goog-Api-Key") != "test-key" || r.Header.Get("Authorization") != "" || r.Header.Get("X-Goog-User-Project") != "quota-project" || r.URL.Query().Get("key") != "" {
+				t.Error("API key behavior changed")
+			}
+			return catalogResponse(200, `{}`), nil
+		})
+		if _, err := s.resolveDiscoverableServices(context.Background()); err != nil {
+			t.Fatal(err)
+		}
+		if _, err := s.fetchGCPPage(context.Background(), "test-service", ""); err != nil {
+			t.Fatal(err)
+		}
+		if calls != 2 {
+			t.Fatalf("calls=%d", calls)
+		}
+	}
+}
+
+func TestGCPServicesErrorRedacted(t *testing.T) {
+	s := NewGCPScraper(&config.Config{GCPAPIKey: "test-key-sensitive"})
+	s.client.Transport = catalogTransport(func(r *http.Request) (*http.Response, error) {
+		if r.Header.Get("X-Goog-Api-Key") != "test-key-sensitive" {
+			t.Error("API key header lost")
+		}
+		return catalogResponse(403, "test-key-sensitive response-secret"), nil
+	})
+	_, err := s.resolveDiscoverableServices(context.Background())
+	if err == nil || strings.Contains(err.Error(), "sensitive") || strings.Contains(err.Error(), "response-secret") {
+		t.Fatalf("expected redacted non-success error, got %v", err)
+	}
+}
diff --git a/internal/scraper/gcp_catalog.go b/internal/scraper/gcp_catalog.go
new file mode 100644
index 0000000..2c93eda
--- /dev/null
+++ b/internal/scraper/gcp_catalog.go
@@ -0,0 +1,40 @@
+package scraper
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+)
+
+type gcpHTTPError struct{ status int }
+
+func (e *gcpHTTPError) Error() string { return fmt.Sprintf("GCP catalog HTTP %d", e.status) }
+
+func isGCPAuthFailure(err error) bool {
+	var status *gcpHTTPError
+	// Google can report invalid API keys as HTTP 400. Fail closed for all 400s,
+	// without parsing or exposing Google's diagnostic body.
+	return errors.Is(err, errGCPAuth) || (errors.As(err, &status) && (status.status == 400 || status.status == 401 || status.status == 403))
+}
+
+// Never expose remote error bodies, headers, request URLs or decoder errors.
+func (s *GCPScraper) catalogJSON(ctx context.Context, target string, out any) error {
+	resp, err := s.catalogRequest(ctx, target)
+	if err != nil {
+		return err
+	}
+	defer resp.Body.Close()
+	if resp.StatusCode != http.StatusOK {
+		return &gcpHTTPError{status: resp.StatusCode}
+	}
+	if err := json.NewDecoder(io.LimitReader(resp.Body, 100*1024*1024)).Decode(out); err != nil {
+		if ctx.Err() != nil {
+			return ctx.Err()
+		}
+		return errors.New("GCP catalog response invalid")
+	}
+	return nil
+}
