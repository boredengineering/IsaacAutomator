diff --git a/internal/scraper/gcp_auth.go b/internal/scraper/gcp_auth.go
new file mode 100644
index 0000000..fa379ce
--- /dev/null
+++ b/internal/scraper/gcp_auth.go
@@ -0,0 +1,162 @@
+package scraper
+
+import (
+	"context"
+	"errors"
+	"net/http"
+	"net/url"
+	"regexp"
+	"sync"
+	"time"
+
+	"golang.org/x/oauth2"
+	"golang.org/x/oauth2/google"
+)
+
+const gcpCatalogScope = "https://www.googleapis.com/auth/cloud-billing.readonly"
+
+var errGCPAuth = errors.New("GCP ADC authentication failed; configure valid Application Default Credentials")
+var errGCPCatalogRequest = errors.New("GCP catalog request failed")
+
+var gcpQuotaProjectPattern = regexp.MustCompile(`^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$`)
+var gcpCredentialPattern = regexp.MustCompile(`^[!-~]+$`)
+
+func rejectGCPRedirect(*http.Request, []*http.Request) error {
+	return errors.New("GCP redirects are not permitted")
+}
+
+// gcpAuth is initialized once per scraper. Its context must live for the entire
+// scrape (including refreshes), not just the first catalog HTTP request.
+type gcpAuth struct {
+	mu      sync.Mutex
+	source  oauth2.TokenSource
+	pending *gcpTokenCall
+}
+
+type gcpTokenCall struct {
+	done  chan struct{}
+	token *oauth2.Token
+	err   error
+}
+
+func defaultGCPTokenSource(ctx context.Context, scope string) (oauth2.TokenSource, error) {
+	// The SDK owns ADC discovery and refresh. Do not call gcloud or fall back to a key.
+	ctx = context.WithValue(ctx, oauth2.HTTPClient, &http.Client{Timeout: 30 * time.Second, CheckRedirect: rejectGCPRedirect})
+	return google.DefaultTokenSource(ctx, scope)
+}
+
+// Preflight validates the selected mode and obtains an initial ADC token before
+// callers start database work. Reuse the scraper with this same live context.
+func (s *GCPScraper) Preflight(ctx context.Context) error {
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	if s.cfg.GCPQuotaProject != "" && !gcpQuotaProjectPattern.MatchString(s.cfg.GCPQuotaProject) {
+		return errors.New("GCP_QUOTA_PROJECT must be a valid project identifier")
+	}
+	switch s.cfg.GCPAuthMode {
+	case "", "api_key":
+		if s.cfg.GCPAPIKey == "" {
+			return errors.New("GCP_API_KEY is required when GCP_AUTH_MODE=api_key")
+		}
+		return nil
+	case "adc":
+	default:
+		return errors.New("GCP_AUTH_MODE must be api_key or adc")
+	}
+	_, err := s.adcToken(ctx)
+	return err
+}
+
+// At most one SDK discovery/refresh is in flight per scraper. A canceled worker
+// stops waiting promptly without canceling the source's scrape-lifetime context
+// or spawning an unbounded number of detached refreshes. SDK HTTP is bounded.
+func (s *GCPScraper) adcToken(ctx context.Context) (*oauth2.Token, error) {
+	if ctx.Err() != nil {
+		return nil, ctx.Err()
+	}
+	s.auth.mu.Lock()
+	call := s.auth.pending
+	if call == nil {
+		call = &gcpTokenCall{done: make(chan struct{})}
+		s.auth.pending = call
+		go func() {
+			call.token, call.err = s.loadADCToken(ctx)
+			s.auth.mu.Lock()
+			s.auth.pending = nil
+			close(call.done)
+			s.auth.mu.Unlock()
+		}()
+	}
+	s.auth.mu.Unlock()
+	select {
+	case <-ctx.Done():
+		return nil, ctx.Err()
+	case <-call.done:
+		if ctx.Err() != nil {
+			return nil, ctx.Err()
+		}
+		return call.token, call.err
+	}
+}
+
+// Only the single in-flight worker accesses/initializes source here.
+func (s *GCPScraper) loadADCToken(ctx context.Context) (*oauth2.Token, error) {
+	if s.auth.source == nil {
+		source, err := s.findTokenSource(ctx, gcpCatalogScope)
+		if ctx.Err() != nil {
+			return nil, ctx.Err()
+		}
+		if err != nil || source == nil {
+			return nil, errGCPAuth
+		}
+		s.auth.source = oauth2.ReuseTokenSource(nil, source)
+	}
+	token, err := s.auth.source.Token()
+	if err != nil || !token.Valid() || !gcpCredentialPattern.MatchString(token.AccessToken) {
+		return nil, errGCPAuth
+	}
+	return token, nil
+}
+
+func (s *GCPScraper) catalogRequest(ctx context.Context, target string) (*http.Response, error) {
+	// Validate before even discovering credentials. No configurable origin, ports,
+	// userinfo, fragments or redirects are allowed for credential-bearing calls.
+	u, err := url.Parse(target)
+	if err != nil || u.Scheme != "https" || u.Host != "cloudbilling.googleapis.com" || u.User != nil || u.Fragment != "" || u.Opaque != "" {
+		return nil, errors.New("GCP catalog destination is not permitted")
+	}
+	if err := s.Preflight(ctx); err != nil {
+		return nil, err
+	}
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, target, nil)
+	if err != nil {
+		return nil, errors.New("GCP catalog request invalid")
+	}
+	if s.cfg.GCPAuthMode == "adc" {
+		token, err := s.adcToken(ctx)
+		if err != nil {
+			return nil, err
+		}
+		req.Header.Set("Authorization", "Bearer "+token.AccessToken)
+	} else {
+		req.Header.Set("X-Goog-Api-Key", s.cfg.GCPAPIKey)
+	}
+	if s.cfg.GCPQuotaProject != "" {
+		req.Header.Set("X-Goog-User-Project", s.cfg.GCPQuotaProject)
+	}
+	client := *s.client
+	client.CheckRedirect = rejectGCPRedirect
+	resp, err := client.Do(req)
+	if err != nil {
+		if ctx.Err() != nil {
+			return nil, ctx.Err()
+		}
+		return nil, errGCPCatalogRequest
+	}
+	if resp.StatusCode >= 300 && resp.StatusCode < 400 {
+		resp.Body.Close()
+		return nil, errors.New("GCP catalog redirects are not permitted")
+	}
+	return resp, nil
+}
