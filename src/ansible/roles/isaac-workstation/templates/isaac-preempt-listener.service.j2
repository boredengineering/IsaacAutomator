[Unit]
Description=GCP Spot Preemption Watchdog & Emergency Backup
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/bin/preempt-listener.py --results-dir {{ results_dir }} --gcs-bucket {{ gcs_backup_bucket }} --deployment-name {{ deployment_name }} --poll-interval 5
Restart=always
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
