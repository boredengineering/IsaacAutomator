#!/usr/bin/env bash
# ==============================================================================
# Scoped Conda Activation Hook: Dynamic NVIDIA Vulkan ICD Manifest Discovery
# ==============================================================================
_ORIG_VK_ICD_FILENAMES="${VK_ICD_FILENAMES:-}"
export _ORIG_VK_ICD_FILENAMES

if [[ -z "${VK_ICD_FILENAMES:-}" ]]; then
    for cand in /usr/share/vulkan/icd.d/nvidia_icd.json \
                /etc/vulkan/icd.d/nvidia_icd.json \
                /usr/local/share/vulkan/icd.d/nvidia_icd.json; do
        if [[ -f "$cand" ]]; then
            export VK_ICD_FILENAMES="$cand"
            break
        fi
    done
fi

export CONDA_PLUGINS_AUTO_ACCEPT_TOS="true"
