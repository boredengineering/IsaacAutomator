#!/usr/bin/env bash
# ==============================================================================
# isaaclab-env: Isolated CLI runner for Isaac Lab named Conda environment
# ==============================================================================
set -e

CONDA_DIR="{{ miniconda_install_dir }}"

# Dynamic Conda Python Resolution
CONDA_PY="{{ miniconda_install_dir }}/envs/{{ conda_env_name }}/bin/python"
if [[ ! -x "${CONDA_PY}" ]]; then
    for cand in "$HOME/miniconda3/envs/{{ conda_env_name }}" "$HOME/.conda/envs/{{ conda_env_name }}" "$HOME/miniforge3/envs/{{ conda_env_name }}" "/opt/conda/envs/{{ conda_env_name }}"; do
        if [[ -x "${cand}/bin/python" ]]; then
            CONDA_PY="${cand}/bin/python"
            break
        fi
    done
fi

ENV_BIN="$(dirname "${CONDA_PY}")"

if [[ -f "${CONDA_DIR}/etc/profile.d/conda.sh" ]]; then
    # shellcheck disable=SC1091
    source "${CONDA_DIR}/etc/profile.d/conda.sh" 2>/dev/null || true
    conda activate "{{ conda_env_name }}" 2>/dev/null || true
fi

if [[ $# -eq 0 ]]; then
    echo "Usage: isaaclab-env <command> [args...]"
    exit 1
fi

if [[ "$1" == "python" || "$1" == "python3" ]]; then
    shift
    if [[ -x "${CONDA_PY}" ]]; then
        export PATH="${ENV_BIN}:$PATH"
        exec "${CONDA_PY}" "$@"
    else
        exec python3 "$@"
    fi
else
    if [[ -x "${CONDA_PY}" ]]; then
        export PATH="${ENV_BIN}:$PATH"
    fi
    exec "$@"
fi
