[Unit]
Description=Sunshine Game and 3D Viewport Streaming Service
After=network.target graphical.target
Wants=graphical.target

[Service]
Type=simple
User={{ ansible_user }}
Group={{ ansible_user }}
Environment=DISPLAY=:0
Environment=HOME=/home/{{ ansible_user }}
ExecStart=/usr/bin/sunshine /home/{{ ansible_user }}/.config/sunshine/sunshine.conf
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
