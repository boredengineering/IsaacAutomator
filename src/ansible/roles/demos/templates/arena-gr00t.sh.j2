set -euo pipefail

LAB_DIR="$(find "$HOME/Documents/GitHub" "$HOME" -maxdepth 4 -name "IsaacLab" -type d 2>/dev/null | head -n 1 || echo "$HOME/IsaacLab")"
ARENA_DIR="$(find "$HOME/Documents/GitHub" "$HOME" -maxdepth 4 -name "IsaacLab-Arena" -type d 2>/dev/null | head -n 1 || echo "$HOME/IsaacLab-Arena")"

if [[ -d "$ARENA_DIR" && -d "$LAB_DIR" ]]; then
    cd "$ARENA_DIR"
    echo "Starting Closed-Loop IsaacLab-Arena + Isaac-GR00T Policy Benchmark..."
    exec "$LAB_DIR/isaaclab.sh" -p isaaclab_arena/evaluation/policy_runner.py \
        --viz kit \
        --policy_type gr00t \
        --policy_host 127.0.0.1 \
        --policy_port {{ gr00t_port | default(5556) }} \
        --num_steps 300 \
        cube_goal_pose
else
    echo "IsaacLab-Arena directory not found at $ARENA_DIR or IsaacLab at $LAB_DIR"
    sleep 3
fi
